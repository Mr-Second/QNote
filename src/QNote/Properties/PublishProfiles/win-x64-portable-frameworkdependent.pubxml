<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
Portable (GitHub channel) framework-dependent variant: WinAppSDK
self-contained + .NET framework-dependent (requires the .NET 10 Desktop
Runtime on the target machine), unpackaged (WindowsPackageType=None).
SCOPING RULE: WindowsPackageType / WindowsAppSDKSelfContained live ONLY in
this profile (or /p: on the command line) - never in Directory.Build.props or
a bare csproj PropertyGroup, or the class-library projects (QNote.Core,
QNote.WreMarkdown) error "should not be applied to a class library".
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish-portable-frameworkdependent\</PublishDir>
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <PublishSingleFile>False</PublishSingleFile>
    <!-- PublishTrimmed stays off (locked by the msix-packaging task, 2026-09-26): IL2104. -->
    <!-- R2R OFF (measured 2026-10-01, Batch 3): -6.7 MB zip (43.7 -> 37.0) for
         +433 ms window-appears on a VERSION-MATCHED runtime (589 -> 1022 ms,
         dev box) - and on user machines whose .NET 10 patch differs, R2R
         images silently fall back to JIT with zero benefit (research §3),
         so the size is paid for a benefit most users never get. The
         self-contained profile keeps R2R: it bundles the exact runtime the
         images were compiled against, so the tradeoff inverts there. -->
    <PublishReadyToRun>False</PublishReadyToRun>
  </PropertyGroup>
  <!--
  Unpackaged publish gap (verified 2026-10-01): the SDK publish pipeline only
  ships items carrying CopyToPublishDirectory; the WinUI targets add the
  Content items (Assets: colors.json, AppIcon.ico, TitleBarIcon.png,
  Fonts/CM_EDITOR.ttf, manifest logos) to the BUILD-output pipeline only
  (AddProcessedXamlFilesToCopyLocal -> CopyToOutputDirectory). Without this
  update the portable zip lacks the whole Assets tree and the app breaks at
  startup (missing palette + ms-appx icon/font resolution).
  Profile-scoped on purpose: the MSIX pipeline (win-x64.pubxml) and plain
  builds never import this file, so their behavior is untouched.
  -->
  <ItemGroup>
    <Content Update="@(Content)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
