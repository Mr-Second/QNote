<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
Packaged (MSIX / Store channel) NativeAOT EXPERIMENT profile (task
10-01-native-aot-experiment, user-approved trial 2026-10-01): same shape as
win-x64.pubxml (SelfContained .NET inside the MSIX, WinAppSDK framework
package from the Store) but PublishAot instead of R2R. NOT wired into any
release path — the Store channel is a manual Partner Center upload; this
profile exists to measure whether AOT is viable for the packaged build too.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish-store-aot\</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>False</PublishSingleFile>
    <PublishReadyToRun>False</PublishReadyToRun>
    <!--
      Store-build language fix (2026-10-04, ships as 1.4.2.0): the MSIX
      packaging flow (Microsoft.Windows.SDK.BuildTools.MSIX — WinAppSdk
      CreatePriConfigXmlForSplitting / _GenerateAppxPackage) re-indexes the
      app resources into the package's resources.pri using autoResourcePackage
      splitting. The default `AppxBundleAutoResourcePackageQualifiers`
      (Language|Scale|DXFeatureLevel) splits Language candidates OUT of the
      main PRI (they are meant for bundle .msixp language packages); a FLAT
      .msix never ships them, and the manifest's x-generate then resolves to
      the default language only. Net effect measured on 1.4.1.0: package PRI
      carried EN-US only, manifest declared <Resource Language="EN-US"/>, and
      EVERY zh user got a permanently-English UI (including 跟随系统) — the
      dev AppX smoke missed it because the F5 layout consumes the healthy
      build QNote.pri instead of the split-reindexed package PRI. Dropping
      Language from the qualifier list keeps zh-Hans candidates in the main
      resources.pri; x-generate then resolves to EN-US + ZH-HANS. Verify after
      every Store build: makepri dump the package PRI (expect Language-ZH-HANS
      candidates) AND read the in-package AppxManifest.xml Resources section
      (expect both languages).
    -->
    <AppxBundleAutoResourcePackageQualifiers>Scale|DXFeatureLevel</AppxBundleAutoResourcePackageQualifiers>
  </PropertyGroup>
</Project>
