<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
Packaged (MSIX / Store channel) NativeAOT EXPERIMENT profile (task
10-01-native-aot-experiment, user-approved trial 2026-10-01): same shape as
win-x64.pubxml (SelfContained .NET inside the MSIX, WinAppSDK framework
package from the Store) but PublishAot instead of R2R. NOT wired into any
release path — the Store channel is a manual Partner Center upload; this
profile exists to measure whether AOT is viable for the packaged build too.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish-store-aot\</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishSingleFile>False</PublishSingleFile>
    <PublishReadyToRun>False</PublishReadyToRun>
  </PropertyGroup>
</Project>
