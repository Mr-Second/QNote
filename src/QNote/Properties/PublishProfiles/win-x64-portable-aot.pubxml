<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
NativeAOT EXPERIMENT profile (task 10-01-native-aot-experiment): .NET
self-contained + WinAppSDK self-contained + PublishAot, unpackaged
(WindowsPackageType=None). Experimental — NOT wired into release.yml; the
GO/NO-GO decision decides whether it replaces the self-contained variant.
SCOPING RULE (same as the other portable profiles):
WindowsPackageType / WindowsAppSDKSelfContained live ONLY in this profile (or
/p: on the command line) — never in Directory.Build.props or a bare csproj
PropertyGroup, or the class-library projects (QNote.Core, QNote.WreMarkdown)
error "should not be applied to a class library".
PublishReadyToRun is meaningless under AOT (already native) and stays off.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish-portable-aot\</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <PublishSingleFile>False</PublishSingleFile>
    <PublishReadyToRun>False</PublishReadyToRun>
  </PropertyGroup>
  <!--
  Unpackaged publish gap (verified 2026-10-01): the SDK publish pipeline only
  ships items carrying CopyToPublishDirectory; the WinUI targets add the
  Content items (Assets: colors.json, AppIcon.ico, TitleBarIcon.png,
  Fonts/CM_EDITOR.ttf, manifest logos) to the BUILD-output pipeline only
  (AddProcessedXamlFilesToCopyLocal -> CopyToOutputDirectory). Without this
  update the portable zip lacks the whole Assets tree and the app breaks at
  startup (missing palette + ms-appx icon/font resolution).
  -->
  <ItemGroup>
    <Content Update="@(Content)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
