<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>QNote</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!--
      Version single source (portable channel): the manifest Version (packaged)
      and the exe VERSIONINFO (unpackaged — read via FileVersionInfo for the
      manual update check) must stay in sync; release.yml patches both from
      the tag.
    -->
    <Version>1.5.0.0</Version>
    <FileVersion>1.5.0.0</FileVersion>
    <!-- Limit NuGet .resources.dll satellites to en + zh-Hans (portable-github-
         channel Batch 3). NOTE (measured 2026-10-01): this property does NOT
         remove the ~80 culture dirs in the output — those are WinUI runtime
         .mui payloads handled by TrimUnusedWindowsAppSdkMuiLanguages below;
         today only one .resources.dll exists in the graph. Kept as a cheap
         guard for future package additions. -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      CsWinRT AOT optimizer: implementing generic WinRT interfaces (e.g.
      ObservableCollection<UIElement> in the generated XamlTypeInfo.g.cs)
      requires generated vtable code that uses unsafe blocks
      (CsWinRT1030). Standard WinUI Native AOT requirement.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Disable the XAML compiler's generated Program.Main (it is guarded by a C#
      preprocessor symbol in the generated App.g.i.cs, so this must go into
      DefineConstants): Program.cs provides the entry point so the
      single-instance guard (AppLifecycle) runs BEFORE Application.Start.
    -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Win2D projection the vendored WinUIRichEditor surface needs (InlineImage
         carries a CanvasBitmap); same wiring the spike applied. -->
    <CsWinRTIncludes>Microsoft.Graphics.Canvas</CsWinRTIncludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\TitleBarIcon.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\colors.json" />
    <!--
      note.svg is the regeneration source for the PNG/ICO assets above, not a
      runtime asset. The WinUI SDK globs Assets/**/*.* into Content
      (EnableDefaultAssets), so it must be removed explicitly or it ships in
      the package and gets indexed into resources.pri.
    -->
    <Content Remove="Assets\note.svg" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Runtime crash-dump backstop (release-prep): arms the runtime's own createdump
    path for FATAL crashes (AccessViolation, stack overflow, native WinAppSDK/COM)
    that by design never reach managed handlers. Must live in runtimeconfig.json:
    Environment.SetEnvironmentVariable in Main proved too late, and the config keys
    carry NO DOTNET_ prefix here (CLRConfig names). Zero runtime cost when no crash
    occurs. Empirical caveat (2026-09-25, this dev machine): WER preempts the
    runtime backstop — neither AV nor FailFast produced a createdump file in any
    configuration; WER itself captured those crashes to %LOCALAPPDATA%\CrashDumps.
    Kept armed because it is the documented mechanism and costs nothing.
    NativeAOT exclusion (2026-10-01, AOT experiment): ilc rejects these as
    "Unexpected feature switch pair" — createdump is a CoreCLR mechanism that
    does not exist in the AOT runtime, so the ItemGroup is gated to
    PublishAot != true. WER (%LOCALAPPDATA%\CrashDumps) still covers AOT
    crashes — see the empirical caveat above.
  -->
  <ItemGroup Condition="'$(PublishAot)' != 'true'">
    <RuntimeHostConfigurationOption Include="DbgEnableMiniDump" Value="1" Trim="true" />
    <RuntimeHostConfigurationOption Include="DbgMiniDumpType" Value="2" Trim="true" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.5.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\QNote.Core\QNote.Core.csproj" />
    <ProjectReference Include="..\QNote.WreMarkdown\QNote.WreMarkdown.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    PublishTrimmed / PublishReadyToRun live in the pubxml profiles (which also set
    SelfContained=true). Keeping them here would fire NETSDK1102 on a plain Release
    BUILD in VS (trimming requires self-contained publish).
  -->

  <!--
    LibArchive.Net runtime trim (msix-packaging task): the NuGet bundles native
    libarchive for EVERY platform under runtimes/ (~33 MB; linux*/osx*/win-x86/
    win-arm64 are dead weight — QNote ships win-x64 MSIX only). The runtimes/
    subtree enters the output as RuntimeTargetsCopyLocalItems from
    ResolvePackageAssets — directly in this project (transitive package) AND
    via QNote.Core's project-reference output group — so filtering
    ResolvedFileToPublish at publish time does NOT catch it (verified
    empirically 2026-09-26). Strip every LibArchive.Net runtime-target asset
    that is not win-x64 at resolution time instead; the flattened win-x64
    archive.dll at the publish root (NativeCopyLocalItems) is unaffected.
    This is the single point of trim: QNote.Core builds RID-less and never
    surfaces RuntimeTargetsCopyLocalItems (verified 2026-09-26 — its output
    carries no native payload once ExcludeAssets="build;buildTransitive" shuts
    off the package's own copy targets), so no filter is needed there.
  -->
  <Target Name="TrimLibArchiveNonWinX64Natives" BeforeTargets="ResolveLockFileCopyLocalFiles">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems
          Remove="@(RuntimeTargetsCopyLocalItems)"
          Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.Identity)').Replace('\', '/').Contains('/libarchive.net/'))
                     and !$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.Identity)').Replace('\', '/').Contains('/runtimes/win-x64/'))" />
    </ItemGroup>
  </Target>

  <!--
    WinAppSDK unused-split trim (portable-github-channel task, PRD 决策 8): the
    Microsoft.WindowsAppSDK 2.5.1 meta package drags its AI / ML / Search / Widgets
    splits along (onnxruntime + DirectML + projections + winmd ≈ 57 MB unpacked at
    R2R) — none of which QNote calls. Swapping to lean split references is not an
    option (H.NotifyIcon.WinUI 2.4.1 transitively pins the meta package), so the
    splits are trimmed at asset-resolution time. Their files reach the output via
    TWO distinct mechanisms (verified empirically 2026-10-01), hence two targets:

    1. TrimUnusedWindowsAppSdkComponentPackages — the split packages are NOT NuGet
       runtime assets: each package's props registers its folder in
       WindowsAppSdkComponentPackages, and Base's SelfContained.targets
       (AddMicrosoftWindowsAppSDKPayloadFilesFromComponents, active when
       WindowsAppSDKSelfContained=true) globs `runtimes-framework\win-$(NativePlatform)
       \native` + `metadata\*.winmd` + workloads json + .pri into None items and
       ReferenceCopyLocalPaths, and feeds the appxfragments to CreateWinRTRegistration
       (the generated WinRT-registration manifest embedded in the exe). Dropping the
       component entries before that target removes the native payload AND keeps the
       trimmed DLLs out of the generated manifest. In framework-package mode (plain
       builds / win-x64.pubxml MSIX) SelfContained.targets is not imported, the
       payload target does not exist, and this hook simply never fires.
    2. TrimUnusedWindowsAppSdkSplitAssets — the managed projections (lib/net*-windows
       assets of AI/Search/Widgets + the ML wrapper) resolve to
       RuntimeCopyLocalItems, and Microsoft.Windows.AI.MachineLearning (transitive
       of the ML split) ships onnxruntime.dll / DirectML.dll via its NuGet `native`
       section → NativeCopyLocalItems. Both merge into ReferenceCopyLocalPaths
       inside ResolveLockFileCopyLocalFiles (Microsoft.PackageDependencyResolution
       .targets), so the same resolution-time filter as the LibArchive trim above
       removes them from bin AND publish. Fires on every build.

    InteractiveExperiences is deliberately NOT trimmed: Microsoft.ui.xaml.dll
    statically imports its natives (Microsoft.UI.Input / Microsoft.UI.Windowing.
    Core / Microsoft.Internal.FrameworkUdk), and Microsoft.WinUI.dll +
    H.NotifyIcon.WinUI.dll + WinUIRichEditor.dll reference
    Microsoft.InteractiveExperiences.Projection (string-swept 2026-10-01 before
    committing to the list). Base / Foundation / WinUI / DWrite / Runtime stay.
  -->
  <Target Name="TrimUnusedWindowsAppSdkComponentPackages" BeforeTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents" Condition="'$(DisableWinAppSdkSplitTrim)' != 'true'">
    <ItemGroup>
      <WindowsAppSdkComponentPackages
          Remove="@(WindowsAppSdkComponentPackages)"
          Condition="$([System.String]::Copy('%(WindowsAppSdkComponentPackages.Identity)').Replace('\', '/').ToLowerInvariant().Contains('/microsoft.windowsappsdk.ai/'))
                     or $([System.String]::Copy('%(WindowsAppSdkComponentPackages.Identity)').Replace('\', '/').ToLowerInvariant().Contains('/microsoft.windowsappsdk.ml/'))
                      or $([System.String]::Copy('%(WindowsAppSdkComponentPackages.Identity)').Replace('\', '/').ToLowerInvariant().Contains('/microsoft.windowsappsdk.search/'))
                      or $([System.String]::Copy('%(WindowsAppSdkComponentPackages.Identity)').Replace('\', '/').ToLowerInvariant().Contains('/microsoft.windowsappsdk.widgets/'))" />
    </ItemGroup>
  </Target>

  <Target Name="TrimUnusedWindowsAppSdkSplitAssets" BeforeTargets="ResolveLockFileCopyLocalFiles" Condition="'$(DisableWinAppSdkSplitTrim)' != 'true'">
    <ItemGroup>
      <RuntimeCopyLocalItems
          Remove="@(RuntimeCopyLocalItems)"
          Condition="$([System.String]::Copy('%(RuntimeCopyLocalItems.Identity)').Replace('\', '/').ToLowerInvariant().Contains('/microsoft.windowsappsdk.ai/'))
                     or $([System.String]::Copy('%(RuntimeCopyLocalItems.Identity)').Replace('\', '/').ToLowerInvariant().Contains('/microsoft.windowsappsdk.search/'))
                     or $([System.String]::Copy('%(RuntimeCopyLocalItems.Identity)').Replace('\', '/').ToLowerInvariant().Contains('/microsoft.windowsappsdk.widgets/'))
                     or $([System.String]::Copy('%(RuntimeCopyLocalItems.Identity)').Replace('\', '/').ToLowerInvariant().Contains('/microsoft.windows.ai.machinelearning/'))" />
      <NativeCopyLocalItems
          Remove="@(NativeCopyLocalItems)"
          Condition="$([System.String]::Copy('%(NativeCopyLocalItems.Identity)').Replace('\', '/').ToLowerInvariant().Contains('/microsoft.windows.ai.machinelearning/'))" />
      <RuntimeTargetsCopyLocalItems
          Remove="@(RuntimeTargetsCopyLocalItems)"
          Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.Identity)').Replace('\', '/').ToLowerInvariant().Contains('/microsoft.windows.ai.machinelearning/'))" />
    </ItemGroup>
  </Target>

  <!--
    WinAppSDK MUI language trim (portable-github-channel Batch 3, quick win ①
    realization): the self-contained payload target in Base's SelfContained
    .targets (AddMicrosoftWindowsAppSDKPayloadFilesFromComponents) globs
    runtimes-framework\win-<arch>\native\**\*.mui into None items with
    CopyToOutputDirectory — the Microsoft.ui.xaml.dll.mui localization dirs,
    ~80 cultures / ~3.2 MB unpacked per output. WinAppSDK exposes no
    SatelliteResourceLanguages-style filter for these (verified 2026-10-01:
    the property had zero effect; the "satellite dirs" in the Batch-2 research
    are these .mui payloads), so they are trimmed by post-filtering the
    payload's None items. Keep en-us / en-GB / zh-CN (QNote ships zh-Hans +
    en UI; WinUI falls back to the .mui default for any other UI language —
    safe for all users). Gated to the SC payload path exactly like the split
    trim above: the payload target only exists when
    WindowsAppSDKSelfContained=true (portable profiles); MSIX / plain builds
    never import SelfContained.targets and this hook never fires. Shares the
    DisableWinAppSdkSplitTrim escape hatch.
  -->
  <Target Name="TrimUnusedWindowsAppSdkMuiLanguages" AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents" Condition="'$(DisableWinAppSdkSplitTrim)' != 'true'">
    <ItemGroup>
      <None Remove="@(None)"
          Condition="'%(None.Extension)' == '.mui'
                     and $([System.String]::Copy('%(None.Identity)').Replace('\', '/').ToLowerInvariant().Contains('/microsoft.windowsappsdk.'))
                     and !$([System.String]::Copy('%(None.Link)').Replace('\', '/').ToLowerInvariant().StartsWith('en-us/'))
                     and !$([System.String]::Copy('%(None.Link)').Replace('\', '/').ToLowerInvariant().StartsWith('en-gb/'))
                     and !$([System.String]::Copy('%(None.Link)').Replace('\', '/').ToLowerInvariant().StartsWith('zh-cn/'))" />
    </ItemGroup>
  </Target>

  <!--
    NativeAOT runtimeconfig trim (drop-fdd task, 2026-10-02): a NativeAOT exe
    has NO CoreCLR and never reads QNote.runtimeconfig.json — yet the SDK still
    generates the file, and it leaked into the store MSIX (verified 2026-10-01:
    a 2 KB copy inside the 11.8 MB AOT MSIX). CoreCLR-based builds DO need it
    at runtime (SC fallback profile, dev dotnet run / dotnet build, plain MSIX),
    so every filter below is gated to PublishAot=true only. The file reaches
    outputs through TWO distinct mechanisms (same shape as the WinAppSDK split
    trim pair above), hence two targets:

    1. TrimRuntimeConfigFromAotPublish — removes the file from
       ResolvedFileToPublish once the publish list is final
       (ComputeFilesToPublish is the SDK target that computes it; the publish
       copy AND the MSIX publish-items output group __GetPublishItems consume
       the same list right after). Belt-and-braces: current .NET 10 SDKs
       already skip this entry under PublishAot (Microsoft.NET.Publish.targets
       gates the direct add with '$(PublishAot)' != 'true'), so on today's SDKs
       the removal finds nothing — the target exists to keep the portable zip
       deterministic across SDK patches.
    2. TrimRuntimeConfigFromAotAppxPayload — under GenerateAppxPackageOnBuild
       the MSIX map is NOT built from the publish dir but from
       @(PackagingOutputs), a merge of build output groups; the runtimeconfig
       rides in via BuiltProjectOutputGroup
       (AddRuntimeConfigFileToBuiltProjectOutputGroupOutput in the SDK has no
       AOT gate). Filter it right before the payload is computed — the same
       BeforeTargets anchor the MSIX targets themselves use for their AOT
       managed-payload removal (WinAppSdkRemoveLinkedFilesFromPayload), which
       is guaranteed to run after GetPackagingOutputs completed.
  -->
  <Target Name="TrimRuntimeConfigFromAotPublish"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'QNote.runtimeconfig.json'" />
    </ItemGroup>
  </Target>

  <Target Name="TrimRuntimeConfigFromAotAppxPayload"
          BeforeTargets="_ComputeAppxPackagePayload"
          Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <PackagingOutputs Remove="@(PackagingOutputs)"
          Condition="'%(PackagingOutputs.Filename)%(PackagingOutputs.Extension)' == 'QNote.runtimeconfig.json'" />
    </ItemGroup>
  </Target>
</Project>
