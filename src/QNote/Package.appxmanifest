<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10/4"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:systemai="http://schemas.microsoft.com/appx/manifest/systemai/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  IgnorableNamespaces="uap rescap systemai uap5">

  <!--
    Publisher must match the subject of the QNote signing certificate exactly
    (certs/qnote.pfx, generated via winapp cert generate with publisher CN=QNote).
    Changing the publisher changes package identity: installs signed with the old
    CN=AppPublisher dev cert must be uninstalled first (no cross-publisher upgrade).
  -->
  <Identity
    Name="71E74B05-BE20-45DC-B948-E90C0A09B4F8"
    Publisher="CN=QNote"
    Version="2.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="71E74B05-BE20-45DC-B948-E90C0A09B4F8" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>QNote</DisplayName>
    <PublisherDisplayName>QNote</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26226.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="QNote"
        Description="QNote"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <!--
        Launch-at-startup (release-prep task). WinUI 3-proven uap5 form: NO
        Executable/EntryPoint attributes — including them makes startup activation
        spawn the process without bringing the app up (see research/autostart-options.md).
        Enabled="false" = opt-in via the settings toggle; the OS StartupTask state is
        the single source of truth (no SQLite key). The task registers after the app
        has been launched once post-install.
      -->
      <Extensions>
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask
            TaskId="QNoteStartup"
            Enabled="false"
            DisplayName="QNote" />
        </uap5:Extension>
        <!--
          Todo reminder toast activation, packaged channel (task 10-04):
          declares the COM local server the OS launches when a reminder toast
          is clicked while QNote is NOT running (cold activation). The CLSID
          must match TodoToastComServer.ActivatorClsid (frozen GUID). The
          in-process class object registered at startup (CoRegisterClassObject)
          serves warm clicks; this declaration covers the cold path — the
          notification platform resolves the packaged AUMID's activator through
          it. Application-scoped per the com:ComServer schema (ExeServer is an
          application extension; com/windows10/4 namespace required for it).
        -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="QNote.exe" DisplayName="QNote">
              <com:Class Id="0D206123-A80D-4247-B145-2C10566F6DAF" DisplayName="QNote notification activator" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!--
      systemAIModels removed (2026-09): unused template leftover. Every declared
      restricted capability needs its own justification in Store review, and the
      app uses no system AI models.
    -->
  </Capabilities>
</Package>
