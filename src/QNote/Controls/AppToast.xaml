<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="QNote.Controls.AppToast"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MaxWidth="420"
    Visibility="Collapsed"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ThemeShadow x:Key="ToastShadow" />
    </UserControl.Resources>

    <!-- Material-style floating toast card: rounded white card + soft shadow,
         colored circular icon badge, bold title, secondary message, close button.
         No callout tail — this is a notification, not a tooltip. -->
    <Border
        x:Name="Card"
        Padding="14,10"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Shadow="{StaticResource ToastShadow}"
        Translation="0,0,32">
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardSlide" />
        </Border.RenderTransform>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="IconBadge"
                Width="22"
                Height="22"
                VerticalAlignment="Top"
                CornerRadius="11">
                <FontIcon
                    x:Name="IconGlyph"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="White" />
            </Border>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    x:Name="TitleText"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="MessageText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Button
                x:Uid="ToastCloseButton"
                Grid.Column="2"
                Padding="6,4"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                Click="Close_Click"
                ToolTipService.ToolTip="关闭">
                <FontIcon FontSize="10" Glyph="&#xE711;" />
            </Button>
        </Grid>
    </Border>
</UserControl>
