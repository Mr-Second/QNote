<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="QNote.Controls.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:QNote.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Compact dialog (half height) + scrollbar. Right padding reserves the
         scrollbar gutter: WinUI overlays the scrollbar ON the content, so
         without it the thumb clips the ComboBox chevrons / ToggleSwitch labels
         when scrolling. The toast is a SIBLING of the ScrollViewer (not inside
         it) so it floats over the panel instead of scrolling/clipping. -->
    <Grid>
        <ScrollViewer MaxHeight="315" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="400" Padding="0,0,8,0" Spacing="16">

            <!-- ============ 显示 ============ -->
            <StackPanel Spacing="2">
                <TextBlock
                    x:Uid="SettingsDisplaySection"
                    Margin="4,0,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="显示" />
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <!-- Row template: label left, control in a FIXED-WIDTH right
                             column so every control's left edge aligns. Combo items are
                             ComboBoxItems (x:String cannot carry x:Uid); SelectedIndex
                             semantics are unchanged. -->
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsDensityLabel" VerticalAlignment="Center" Text="列表间距" />
                            <ComboBox
                                x:Uid="SettingsDensityBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="SettingsDensityBox"
                                SelectedIndex="{x:Bind ViewModel.DensityIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="DensityCompact" Content="紧凑" />
                                <ComboBoxItem x:Uid="DensityStandard" Content="标准" />
                                <ComboBoxItem x:Uid="DensityComfortable" Content="宽松" />
                            </ComboBox>
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsTimeFormatLabel" VerticalAlignment="Center" Text="时间格式" />
                            <ComboBox
                                x:Uid="SettingsTimeFormatBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="SettingsTimeFormatBox"
                                SelectedIndex="{x:Bind ViewModel.TimeFormatIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="TimeFormatRelative" Content="相对（3 分钟前）" />
                                <ComboBoxItem x:Uid="TimeFormatTiered" Content="分级（今日时分）" />
                                <ComboBoxItem x:Uid="TimeFormatFull" Content="完整（年-月-日 时分）" />
                            </ComboBox>
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsSortLabel" VerticalAlignment="Center" Text="便签排序" />
                            <ComboBox
                                x:Uid="SettingsSortBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="SettingsSortBox"
                                SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="SortUpdated" Content="更新时间" />
                                <ComboBoxItem x:Uid="SortCreated" Content="创建时间" />
                                <ComboBoxItem x:Uid="SortTitle" Content="标题" />
                            </ComboBox>
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsConfirmDeleteLabel" VerticalAlignment="Center" Text="删除前确认" />
                            <ToggleSwitch
                                x:Uid="SettingsConfirmDeleteSwitch"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsConfirmDeleteSwitch"
                                IsOn="{x:Bind ViewModel.ConfirmBeforeDelete, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ 常规 ============ -->
            <StackPanel Spacing="2">
                <TextBlock
                    x:Uid="SettingsGeneralSection"
                    Margin="4,0,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="常规" />
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsThemeLabel" VerticalAlignment="Center" Text="主题" />
                            <ComboBox
                                x:Uid="SettingsThemeBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="SettingsThemeBox"
                                SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="ThemeSystem" Content="跟随系统" />
                                <ComboBoxItem x:Uid="ThemeLight" Content="浅色" />
                                <ComboBoxItem x:Uid="ThemeDark" Content="深色" />
                            </ComboBox>
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <!-- Language row: a change re-navigates the whole UI (see
                             MainWindow.SwitchLanguageAsync); the settings dialog
                             itself stays in its previous language until reopened. -->
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsLanguageLabel" VerticalAlignment="Center" Text="语言" />
                            <ComboBox
                                x:Uid="SettingsLanguageBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="SettingsLanguageBox"
                                SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="LangSystem" Content="跟随系统" />
                                <ComboBoxItem x:Uid="LangChinese" Content="中文" />
                                <ComboBoxItem x:Uid="LangEnglish" Content="English" />
                            </ComboBox>
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsAutoSaveLabel" VerticalAlignment="Center" Text="自动保存" />
                            <ComboBox
                                x:Uid="SettingsAutoSaveBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="SettingsAutoSaveBox"
                                SelectedIndex="{x:Bind ViewModel.AutoSaveIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="AutoSaveOff" Content="关闭" />
                                <ComboBoxItem x:Uid="AutoSave500Ms" Content="500 毫秒" />
                                <ComboBoxItem x:Uid="AutoSave1S" Content="1 秒" />
                                <ComboBoxItem x:Uid="AutoSave2S" Content="2 秒" />
                                <ComboBoxItem x:Uid="AutoSave5S" Content="5 秒" />
                                <ComboBoxItem x:Uid="AutoSave10S" Content="10 秒" />
                                <ComboBoxItem x:Uid="AutoSave30S" Content="30 秒" />
                            </ComboBox>
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsTopmostLabel" VerticalAlignment="Center" Text="窗口置顶" />
                            <ToggleSwitch
                                x:Uid="SettingsTopmostSwitch"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsTopmostSwitch"
                                IsOn="{x:Bind ViewModel.AlwaysOnTop, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsEdgeHideLabel" VerticalAlignment="Center" Text="贴边自动隐藏" />
                            <ToggleSwitch
                                x:Uid="SettingsEdgeHideSwitch"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsEdgeHideSwitch"
                                IsOn="{x:Bind ViewModel.EdgeHideEnabled, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsEdgeHideTaskbarLabel" VerticalAlignment="Center" Text="贴边隐藏时隐藏任务栏图标" />
                            <ToggleSwitch
                                x:Uid="SettingsEdgeHideTaskbarSwitch"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsEdgeHideTaskbarSwitch"
                                IsEnabled="{x:Bind ViewModel.EdgeHideEnabled, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.HideTaskbarIconOnEdgeHide, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsHotkeyLabel" VerticalAlignment="Center" Text="隐藏/显示快捷键" />
                                <Button
                                    x:Name="HotkeyButton"
                                    x:Uid="SettingsHotkeyButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    AutomationProperties.AutomationId="SettingsHotkeyButton"
                                    Click="Hotkey_Click"
                                    PreviewKeyDown="Hotkey_PreviewKeyDown"
                                    ToolTipService.ToolTip="点击后按下新快捷键；Esc 取消，Backspace 清空">
                                    <TextBlock
                                        HorizontalTextAlignment="Center"
                                        Text="{x:Bind ViewModel.HotkeyDisplay, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </Button>
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsGeometryLabel" VerticalAlignment="Center" Text="记住窗口位置和大小" />
                            <ToggleSwitch
                                x:Uid="SettingsGeometrySwitch"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsGeometrySwitch"
                                IsOn="{x:Bind ViewModel.RememberWindowGeometry, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsStartMinimizedLabel" VerticalAlignment="Center" Text="启动时不显示主窗口" />
                            <ToggleSwitch
                                x:Uid="SettingsStartMinimizedSwitch"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsStartMinimizedSwitch"
                                IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsStartupUpdateCheckLabel" VerticalAlignment="Center" Text="启动时检查更新" />
                            <ToggleSwitch
                                x:Uid="SettingsStartupUpdateCheckSwitch"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsStartupUpdateCheckSwitch"
                                IsOn="{x:Bind ViewModel.CheckUpdatesOnStartup, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsLaunchAtStartupLabel" VerticalAlignment="Center" Text="开机自启动" />
                            <!-- Right column stacks the toggle over the hint: the OS
                                 StartupTask state is the source of truth, so the toggle
                                 can be refused (DisabledByUser) and must explain why. -->
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <ToggleSwitch
                                    x:Uid="SettingsLaunchAtStartupSwitch"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="SettingsLaunchAtStartupSwitch"
                                    IsEnabled="{x:Bind ViewModel.LaunchAtStartupToggleEnabled, Mode=OneWay}"
                                    IsOn="{x:Bind ViewModel.LaunchAtStartup, Mode=TwoWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.LaunchAtStartupHint, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <!-- Manual update check (GitHub Releases) — unpackaged/portable
                             runs only (the VM hides the whole unit, divider included,
                             for packaged/Store runs). The command disables the button
                             while running; the button text shows the progress state. -->
                        <StackPanel Visibility="{x:Bind ViewModel.UpdateCheckVisible, Mode=OneWay}">
                            <Border
                                Margin="10,0"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0" />
                            <Grid Padding="10,3" ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="152" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="SettingsUpdateCheckLabel" VerticalAlignment="Center" Text="软件更新" />
                                <Button
                                    x:Uid="SettingsUpdateCheckButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="SettingsUpdateCheckButton"
                                    Command="{x:Bind ViewModel.CheckUpdateCommand, Mode=OneWay}"
                                    Content="{x:Bind ViewModel.UpdateCheckButtonText, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ 待办 ============ -->
            <!-- Smart-list visibility RESTORE path (list-options ⋯ menu,
                 2026-10-16): 隐藏智能列表 hides a view from the todo nav; these
                 switches bring it back. 全部 is the fallback view and never
                 hideable, so it has no switch here. -->
            <StackPanel Spacing="2">
                <TextBlock
                    x:Uid="SettingsTodoSection"
                    Margin="4,0,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="待办" />
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsTodoTodayLabel" VerticalAlignment="Center" Text="显示「今日」" />
                            <ToggleSwitch
                                x:Uid="SettingsTodoTodaySwitch"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsTodoTodaySwitch"
                                IsOn="{x:Bind ViewModel.TodoTodayVisible, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsTodoImportantLabel" VerticalAlignment="Center" Text="显示「重要」" />
                            <ToggleSwitch
                                x:Uid="SettingsTodoImportantSwitch"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsTodoImportantSwitch"
                                IsOn="{x:Bind ViewModel.TodoImportantVisible, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsTodoPlannedLabel" VerticalAlignment="Center" Text="显示「计划内」" />
                            <ToggleSwitch
                                x:Uid="SettingsTodoPlannedSwitch"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsTodoPlannedSwitch"
                                IsOn="{x:Bind ViewModel.TodoPlannedVisible, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ 数据 ============ -->
            <StackPanel Spacing="2">
                <TextBlock
                    x:Uid="SettingsDataSection"
                    Margin="4,0,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="数据" />
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <!-- Only ONE ContentDialog may be open at a time: these buttons ask
                         the host to close the settings dialog first, then open the
                         backup/restore dialog (see SettingsPanel.BackupRequested).
                         Same fixed-width right column as the other rows, so the
                         buttons' left edge aligns with the ComboBoxes/ToggleSwitches. -->
                    <Grid Padding="10,3" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="152" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="SettingsBackupRestoreLabel" VerticalAlignment="Center" Text="备份与恢复（.qns 文件）" />
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                x:Uid="SettingsBackupButton"
                                AutomationProperties.AutomationId="SettingsBackupButton"
                                Click="Backup_Click"
                                Content="备份…" />
                            <Button
                                x:Uid="SettingsRestoreButton"
                                AutomationProperties.AutomationId="SettingsRestoreButton"
                                Click="Restore_Click"
                                Content="恢复…" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ============ 同步 ============ -->
            <!-- Provider/account configuration only. Manual sync stays in the main header. -->
            <StackPanel Spacing="2">
                <TextBlock
                    x:Uid="SettingsSyncSection"
                    Margin="4,0,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="同步" />
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsSyncProviderLabel" Text="同步方式" VerticalAlignment="Center" />
                            <ComboBox x:Uid="SettingsSyncProvider" Grid.Column="1"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                      IsEnabled="{x:Bind ViewModel.SyncConfigurationEnabled, Mode=OneWay}"
                                      AutomationProperties.Name="同步方式"
                                      AutomationProperties.AutomationId="SettingsSyncProvider"
                                      SelectedIndex="{x:Bind ViewModel.SyncProviderIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{x:Bind ViewModel.SyncOneDriveOptionText, Mode=OneWay}"
                                              AutomationProperties.Name="{x:Bind ViewModel.SyncOneDriveOptionName, Mode=OneWay}"
                                              AutomationProperties.AutomationId="SettingsSyncOneDrive" />
                                <ComboBoxItem Content="{x:Bind ViewModel.SyncWebDavOptionText, Mode=OneWay}"
                                              AutomationProperties.Name="{x:Bind ViewModel.SyncWebDavOptionName, Mode=OneWay}"
                                              AutomationProperties.AutomationId="SettingsSyncWebDav" />
                            </ComboBox>
                        </Grid>
                        <Border Margin="10,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0" />
                        <StackPanel Padding="10,12" Spacing="12"
                                    Visibility="{x:Bind ViewModel.SyncWebDavSelected, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                            <TextBox x:Uid="SettingsWebDavUrl" Header="同步文件夹地址（HTTP / HTTPS）"
                                     IsEnabled="{x:Bind ViewModel.SyncConfigurationEnabled, Mode=OneWay}"
                                     PlaceholderText="https://dav.example.com/QNote/"
                                     AutomationProperties.AutomationId="SettingsWebDavUrl"
                                     Text="{x:Bind ViewModel.WebDavFolderUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock x:Uid="SettingsWebDavHttpWarning"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.ShowWebDavHttpWarning, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                       Text="连接未加密：用户名、应用密码和笔记内容可能被监听。请仅在你信任的网络中使用 HTTP。" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="SettingsWebDavUsername" PlaceholderText="用户名"
                                         IsEnabled="{x:Bind ViewModel.SyncConfigurationEnabled, Mode=OneWay}"
                                         AutomationProperties.Name="用户名"
                                         AutomationProperties.AutomationId="SettingsWebDavUsername"
                                         Text="{x:Bind ViewModel.WebDavUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <PasswordBox x:Uid="SettingsWebDavPassword" Grid.Column="1" PlaceholderText="应用密码"
                                             IsEnabled="{x:Bind ViewModel.SyncConfigurationEnabled, Mode=OneWay}"
                                             AutomationProperties.Name="应用密码"
                                             AutomationProperties.AutomationId="SettingsWebDavPassword"
                                             Password="{x:Bind ViewModel.WebDavPassword, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock x:Uid="SettingsWebDavHint" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="请填写专用于 QNote 的文件夹地址。地址和用户名不变时，密码留空会保留已保存的密码。" />
                        </StackPanel>
                        <Grid Padding="10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <!-- Match the provider's 152px right column: 56 + 8 + 88. -->
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Visibility="{x:Bind ViewModel.SyncOneDriveSelected, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                <Button
                                    x:Name="SignInButton"
                                    x:Uid="SettingsSyncAuthButton"
                                    Width="56"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Center"
                                    AutomationProperties.AutomationId="SettingsSyncAuthButton"
                                    Command="{x:Bind ViewModel.SyncAuthCommand, Mode=OneWay}"
                                    Content="{x:Bind ViewModel.SyncSignInText, Mode=OneTime}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.SyncAccountDisplay, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.SyncSignedIn, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}" />
                                <Button
                                    x:Name="SignOutButton"
                                    x:Uid="SettingsSyncAuthButton"
                                    Width="56"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Center"
                                    AutomationProperties.AutomationId="SettingsSyncSignOutButton"
                                    Command="{x:Bind ViewModel.SyncAuthCommand, Mode=OneWay}"
                                    Content="{x:Bind ViewModel.SyncSignOutText, Mode=OneTime}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.SyncAccountDisplay, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.SyncSignedIn, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                    <!-- Destructive 注销 = solid red + white label for every
                                         state (user ruling 2026-10-23: a critical-tint
                                         background with red text read as "broken"). -->
                                    <Button.Resources>
                                        <ResourceDictionary>
                                            <SolidColorBrush x:Key="ButtonBackground" Color="#C42B1C" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D13438" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A7221A" />
                                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#C42B1C" />
                                            <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                                            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#80FFFFFF" />
                                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#C42B1C" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#D13438" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#A7221A" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#C42B1C" />
                                        </ResourceDictionary>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8"
                                        Visibility="{x:Bind ViewModel.SyncWebDavSelected, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                            <Button x:Uid="SettingsWebDavTest" Content="测试连接" Height="32" Padding="8,4" HorizontalAlignment="Left"
                                    IsEnabled="{x:Bind ViewModel.SyncConfigurationEnabled, Mode=OneWay}"
                                    AutomationProperties.AutomationId="SettingsWebDavTest"
                                    Command="{x:Bind ViewModel.TestWebDavCommand, Mode=OneTime}" />
                            <Button x:Uid="SettingsWebDavForget" Content="清除 WebDAV 配置" Height="32" Padding="8,4"
                                    ToolTipService.ToolTip="清除此设备保存的 WebDAV 文件夹地址、用户名和应用密码，并切换到 OneDrive。不会删除云端内容。"
                                    IsEnabled="{x:Bind ViewModel.SyncConfigurationEnabled, Mode=OneWay}"
                                    AutomationProperties.AutomationId="SettingsWebDavForget"
                                    Command="{x:Bind ViewModel.ForgetWebDavCommand, Mode=OneTime}" />
                            </StackPanel>
                            <Button x:Uid="SettingsSyncSave" Grid.Column="3" Content="保存并启用" Height="32" Padding="8,4" HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind ViewModel.SyncConfigurationEnabled, Mode=OneWay}"
                                    AutomationProperties.Name="保存并启用同步"
                                    AutomationProperties.AutomationId="SettingsSyncSave"
                                    Command="{x:Bind ViewModel.SaveSyncConfigurationCommand, Mode=OneTime}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ 关于 ============ -->
            <StackPanel Spacing="2">
                <TextBlock
                    x:Uid="SettingsAboutSection"
                    Margin="4,0,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="关于" />
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <!-- Full-row entry (Windows-Settings style): the row IS the
                         button — icon + product name + chevron, no redundant
                         关于 wording on top of the section header. Same
                         one-dialog choreography as the 数据 buttons (the row
                         asks the host to close settings, then open About). The
                         accessible name (resw) carries the full "关于 QNote"
                         wording for screen readers without visual repetition. -->
                    <Button
                        x:Uid="SettingsAboutButton"
                        Margin="8,6"
                        Padding="8,6"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="SettingsAboutButton"
                        Click="About_Click">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Source="ms-appx:///Assets/TitleBarIcon.png" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="QNote" />
                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </Button>
                </Border>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <!-- Floating toast for the sign-in/out outcome (auto-dismiss). -->
        <controls:AppToast
            x:Name="ResultTip"
            Margin="0,2,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top" />
    </Grid>
</UserControl>
