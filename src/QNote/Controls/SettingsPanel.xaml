<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="QNote.Controls.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Compact dialog (half height) + scrollbar. Right padding reserves the
         scrollbar gutter: WinUI overlays the scrollbar ON the content, so
         without it the thumb clips the ComboBox chevrons / ToggleSwitch labels
         when scrolling. -->
    <ScrollViewer MaxHeight="315" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="400" Padding="0,0,8,0" Spacing="16">

            <!-- ============ 显示 ============ -->
            <StackPanel Spacing="2">
                <TextBlock
                    x:Uid="SettingsDisplaySection"
                    Margin="4,0,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="显示" />
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <!-- Row template: label left, control in a FIXED-WIDTH right
                             column so every control's left edge aligns. Combo items are
                             ComboBoxItems (x:String cannot carry x:Uid); SelectedIndex
                             semantics are unchanged. -->
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsDensityLabel" VerticalAlignment="Center" Text="列表密度" />
                            <ComboBox
                                x:Uid="SettingsDensityBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="SettingsDensityBox"
                                SelectedIndex="{x:Bind ViewModel.DensityIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="DensityCompact" Content="紧凑" />
                                <ComboBoxItem x:Uid="DensityStandard" Content="标准" />
                                <ComboBoxItem x:Uid="DensityComfortable" Content="宽松" />
                            </ComboBox>
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsTimeFormatLabel" VerticalAlignment="Center" Text="时间格式" />
                            <ComboBox
                                x:Uid="SettingsTimeFormatBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="SettingsTimeFormatBox"
                                SelectedIndex="{x:Bind ViewModel.TimeFormatIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="TimeFormatRelative" Content="相对（3 分钟前）" />
                                <ComboBoxItem x:Uid="TimeFormatTiered" Content="分级（今日时分）" />
                                <ComboBoxItem x:Uid="TimeFormatFull" Content="完整（年-月-日 时分）" />
                            </ComboBox>
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsSortLabel" VerticalAlignment="Center" Text="便签排序" />
                            <ComboBox
                                x:Uid="SettingsSortBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="SettingsSortBox"
                                SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="SortUpdated" Content="更新时间" />
                                <ComboBoxItem x:Uid="SortCreated" Content="创建时间" />
                                <ComboBoxItem x:Uid="SortTitle" Content="标题" />
                            </ComboBox>
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsConfirmDeleteLabel" VerticalAlignment="Center" Text="删除前确认" />
                            <ToggleSwitch
                                x:Uid="SettingsConfirmDeleteSwitch"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsConfirmDeleteSwitch"
                                IsOn="{x:Bind ViewModel.ConfirmBeforeDelete, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ 常规 ============ -->
            <StackPanel Spacing="2">
                <TextBlock
                    x:Uid="SettingsGeneralSection"
                    Margin="4,0,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="常规" />
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsThemeLabel" VerticalAlignment="Center" Text="主题" />
                            <ComboBox
                                x:Uid="SettingsThemeBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="SettingsThemeBox"
                                SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="ThemeSystem" Content="跟随系统" />
                                <ComboBoxItem x:Uid="ThemeLight" Content="浅色" />
                                <ComboBoxItem x:Uid="ThemeDark" Content="深色" />
                            </ComboBox>
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <!-- Language row: a change re-navigates the whole UI (see
                             MainWindow.SwitchLanguageAsync); the settings dialog
                             itself stays in its previous language until reopened. -->
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsLanguageLabel" VerticalAlignment="Center" Text="语言" />
                            <ComboBox
                                x:Uid="SettingsLanguageBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="SettingsLanguageBox"
                                SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="LangSystem" Content="跟随系统" />
                                <ComboBoxItem x:Uid="LangChinese" Content="中文" />
                                <ComboBoxItem x:Uid="LangEnglish" Content="English" />
                            </ComboBox>
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsAutoSaveLabel" VerticalAlignment="Center" Text="自动保存" />
                            <ComboBox
                                x:Uid="SettingsAutoSaveBox"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="SettingsAutoSaveBox"
                                SelectedIndex="{x:Bind ViewModel.AutoSaveIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="AutoSaveOff" Content="关闭" />
                                <ComboBoxItem x:Uid="AutoSave500Ms" Content="500 毫秒" />
                                <ComboBoxItem x:Uid="AutoSave1S" Content="1 秒" />
                                <ComboBoxItem x:Uid="AutoSave2S" Content="2 秒" />
                                <ComboBoxItem x:Uid="AutoSave5S" Content="5 秒" />
                                <ComboBoxItem x:Uid="AutoSave10S" Content="10 秒" />
                                <ComboBoxItem x:Uid="AutoSave30S" Content="30 秒" />
                            </ComboBox>
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsTopmostLabel" VerticalAlignment="Center" Text="窗口置顶" />
                            <ToggleSwitch
                                x:Uid="SettingsTopmostSwitch"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsTopmostSwitch"
                                IsOn="{x:Bind ViewModel.AlwaysOnTop, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsEdgeHideLabel" VerticalAlignment="Center" Text="贴边自动隐藏" />
                            <ToggleSwitch
                                x:Uid="SettingsEdgeHideSwitch"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsEdgeHideSwitch"
                                IsOn="{x:Bind ViewModel.EdgeHideEnabled, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsEdgeHideTaskbarLabel" VerticalAlignment="Center" Text="贴边隐藏时隐藏任务栏图标" />
                            <ToggleSwitch
                                x:Uid="SettingsEdgeHideTaskbarSwitch"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsEdgeHideTaskbarSwitch"
                                IsEnabled="{x:Bind ViewModel.EdgeHideEnabled, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.HideTaskbarIconOnEdgeHide, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsHotkeyLabel" VerticalAlignment="Center" Text="隐藏/显示快捷键" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <Button
                                    x:Name="HotkeyButton"
                                    x:Uid="SettingsHotkeyButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    AutomationProperties.AutomationId="SettingsHotkeyButton"
                                    Click="Hotkey_Click"
                                    PreviewKeyDown="Hotkey_PreviewKeyDown"
                                    ToolTipService.ToolTip="点击后按下新快捷键；Esc 取消，Backspace 清空">
                                    <TextBlock
                                        HorizontalTextAlignment="Center"
                                        Text="{x:Bind ViewModel.HotkeyDisplay, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </Button>
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.HotkeyError, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsGeometryLabel" VerticalAlignment="Center" Text="记住窗口位置和大小" />
                            <ToggleSwitch
                                x:Uid="SettingsGeometrySwitch"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsGeometrySwitch"
                                IsOn="{x:Bind ViewModel.RememberWindowGeometry, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsStartMinimizedLabel" VerticalAlignment="Center" Text="启动时最小化到托盘" />
                            <ToggleSwitch
                                x:Uid="SettingsStartMinimizedSwitch"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsStartMinimizedSwitch"
                                IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="SettingsLaunchAtStartupLabel" VerticalAlignment="Center" Text="开机自启动" />
                            <!-- Right column stacks the toggle over the hint: the OS
                                 StartupTask state is the source of truth, so the toggle
                                 can be refused (DisabledByUser) and must explain why. -->
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <ToggleSwitch
                                    x:Uid="SettingsLaunchAtStartupSwitch"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="SettingsLaunchAtStartupSwitch"
                                    IsEnabled="{x:Bind ViewModel.LaunchAtStartupToggleEnabled, Mode=OneWay}"
                                    IsOn="{x:Bind ViewModel.LaunchAtStartup, Mode=TwoWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.LaunchAtStartupHint, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <!-- Manual update check (GitHub Releases) — unpackaged/portable
                             runs only (the VM hides the whole unit, divider included,
                             for packaged/Store runs). The command disables the button
                             while running; the button text shows the progress state. -->
                        <StackPanel Visibility="{x:Bind ViewModel.UpdateCheckVisible, Mode=OneWay}">
                            <Border
                                Margin="10,0"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0" />
                            <Grid Padding="10,3" ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="152" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="SettingsUpdateCheckLabel" VerticalAlignment="Center" Text="软件更新" />
                                <Button
                                    x:Uid="SettingsUpdateCheckButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="SettingsUpdateCheckButton"
                                    Command="{x:Bind ViewModel.CheckUpdateCommand, Mode=OneWay}"
                                    Content="{x:Bind ViewModel.UpdateCheckButtonText, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ 数据 ============ -->
            <StackPanel Spacing="2">
                <TextBlock
                    x:Uid="SettingsDataSection"
                    Margin="4,0,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="数据" />
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <!-- Only ONE ContentDialog may be open at a time: these buttons ask
                         the host to close the settings dialog first, then open the
                         backup/restore dialog (see SettingsPanel.BackupRequested).
                         Same fixed-width right column as the other rows, so the
                         buttons' left edge aligns with the ComboBoxes/ToggleSwitches. -->
                    <Grid Padding="10,3" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="152" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="SettingsBackupRestoreLabel" VerticalAlignment="Center" Text="备份与恢复（.qns 文件）" />
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                x:Uid="SettingsBackupButton"
                                AutomationProperties.AutomationId="SettingsBackupButton"
                                Click="Backup_Click"
                                Content="备份…" />
                            <Button
                                x:Uid="SettingsRestoreButton"
                                AutomationProperties.AutomationId="SettingsRestoreButton"
                                Click="Restore_Click"
                                Content="恢复…" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ============ 关于 ============ -->
            <StackPanel Spacing="2">
                <TextBlock
                    x:Uid="SettingsAboutSection"
                    Margin="4,0,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="关于" />
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <!-- Same one-dialog choreography as the 数据 buttons: the row
                         asks the host to close the settings dialog first, then open
                         the About dialog (see SettingsPanel.AboutRequested). -->
                    <Grid Padding="10,3" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="152" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="SettingsAboutLabel" VerticalAlignment="Center" Text="关于 QNote" />
                        <Button
                            x:Uid="SettingsAboutButton"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="SettingsAboutButton"
                            Click="About_Click"
                            Content="关于…" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
