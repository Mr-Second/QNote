<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="QNote.Controls.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Compact dialog (half height) + scrollbar. Right padding reserves the
         scrollbar gutter: WinUI overlays the scrollbar ON the content, so
         without it the thumb clips the ComboBox chevrons / ToggleSwitch labels
         when scrolling. -->
    <ScrollViewer MaxHeight="315" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="400" Padding="0,0,8,0" Spacing="16">

            <!-- ============ 显示 ============ -->
            <StackPanel Spacing="2">
                <TextBlock
                    Margin="4,0,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="显示" />
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <!-- Row template: label left, control in a FIXED-WIDTH right
                             column so every control's left edge aligns. -->
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="列表密度" />
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="SettingsDensityBox"
                                AutomationProperties.Name="列表密度"
                                SelectedIndex="{x:Bind ViewModel.DensityIndex, Mode=TwoWay}">
                                <x:String>紧凑</x:String>
                                <x:String>标准</x:String>
                                <x:String>宽松</x:String>
                            </ComboBox>
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="时间格式" />
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="SettingsTimeFormatBox"
                                AutomationProperties.Name="时间格式"
                                SelectedIndex="{x:Bind ViewModel.TimeFormatIndex, Mode=TwoWay}">
                                <x:String>相对（3 分钟前）</x:String>
                                <x:String>分级（今日时分）</x:String>
                                <x:String>完整（年-月-日 时分）</x:String>
                            </ComboBox>
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="便签排序" />
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="SettingsSortBox"
                                AutomationProperties.Name="便签排序"
                                SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                                <x:String>更新时间</x:String>
                                <x:String>创建时间</x:String>
                                <x:String>标题</x:String>
                            </ComboBox>
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="删除前确认" />
                            <ToggleSwitch
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsConfirmDeleteSwitch"
                                AutomationProperties.Name="删除前确认"
                                IsOn="{x:Bind ViewModel.ConfirmBeforeDelete, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ 常规 ============ -->
            <StackPanel Spacing="2">
                <TextBlock
                    Margin="4,0,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="常规" />
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="主题" />
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="SettingsThemeBox"
                                AutomationProperties.Name="主题"
                                SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                                <x:String>跟随系统</x:String>
                                <x:String>浅色</x:String>
                                <x:String>深色</x:String>
                            </ComboBox>
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="窗口置顶" />
                            <ToggleSwitch
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsTopmostSwitch"
                                AutomationProperties.Name="窗口置顶"
                                IsOn="{x:Bind ViewModel.AlwaysOnTop, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="贴边自动隐藏" />
                            <ToggleSwitch
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsEdgeHideSwitch"
                                AutomationProperties.Name="贴边自动隐藏"
                                IsOn="{x:Bind ViewModel.EdgeHideEnabled, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="贴边隐藏时隐藏任务栏图标" />
                            <ToggleSwitch
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsEdgeHideTaskbarSwitch"
                                AutomationProperties.Name="贴边隐藏时隐藏任务栏图标"
                                IsEnabled="{x:Bind ViewModel.EdgeHideEnabled, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.HideTaskbarIconOnEdgeHide, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="隐藏/显示快捷键" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <Button
                                    x:Name="HotkeyButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    AutomationProperties.AutomationId="SettingsHotkeyButton"
                                    AutomationProperties.Name="隐藏/显示快捷键"
                                    Click="Hotkey_Click"
                                    PreviewKeyDown="Hotkey_PreviewKeyDown"
                                    ToolTipService.ToolTip="点击后按下新快捷键；Esc 取消，Backspace 清空">
                                    <TextBlock
                                        HorizontalTextAlignment="Center"
                                        Text="{x:Bind ViewModel.HotkeyDisplay, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </Button>
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.HotkeyError, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="记住窗口位置和大小" />
                            <ToggleSwitch
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsGeometrySwitch"
                                AutomationProperties.Name="记住窗口位置和大小"
                                IsOn="{x:Bind ViewModel.RememberWindowGeometry, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            Margin="10,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid Padding="10,3" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="152" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="启动时最小化到托盘" />
                            <ToggleSwitch
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="SettingsStartMinimizedSwitch"
                                AutomationProperties.Name="启动时最小化到托盘"
                                IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ 数据 ============ -->
            <StackPanel Spacing="2">
                <TextBlock
                    Margin="4,0,0,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="数据" />
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <!-- Only ONE ContentDialog may be open at a time: these buttons ask
                         the host to close the settings dialog first, then open the
                         backup/restore dialog (see SettingsPanel.BackupRequested).
                         Same fixed-width right column as the other rows, so the
                         buttons' left edge aligns with the ComboBoxes/ToggleSwitches. -->
                    <Grid Padding="10,3" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="152" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="备份与恢复（.qns 文件）" />
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                AutomationProperties.AutomationId="SettingsBackupButton"
                                AutomationProperties.Name="备份数据"
                                Click="Backup_Click"
                                Content="备份…" />
                            <Button
                                AutomationProperties.AutomationId="SettingsRestoreButton"
                                AutomationProperties.Name="恢复数据"
                                Click="Restore_Click"
                                Content="恢复…" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
