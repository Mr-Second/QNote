<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:QNote.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:HexToBrushConverter x:Key="HexToBrush" />
    <conv:ListDensityConverter x:Key="ListDensity" />

    <!-- Shared, keyed styles. Reused across views, never copy-pasted per view. -->
    <Style x:Key="NoteTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Layered card panel floated over the window's Mica backdrop (rounded + stroke). -->
    <Style x:Key="PanelCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Compact editor-toolbar app-bar buttons (CommandBar in NotesPage). The stock
         AppBar(Toggle)Button chrome (~40px tall, loose padding) reads bulky next to
         the editor; these setters shrink it back to the old ~26px toolbar look.
         The bar/glyph/inner-margin metrics they rely on (AppBarThemeCompactHeight,
         AppBarButtonContentHeight, AppBarButtonInnerBorderCompactMargin) are
         overridden in the CommandBar's own Resources (Resources cannot ride a
         Style setter). -->
    <Style x:Key="EditorToolbarAppBarToggleButtonStyle" TargetType="AppBarToggleButton">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="EditorToolbarAppBarButtonStyle" TargetType="AppBarButton">
        <Setter Property="Width" Value="NaN" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- New-note button (Qt parity: soft accent tint circle, "+" in accent, never
         a solid accent fill in any state). PointerOver/Pressed theme-resource
         overrides live inline on NewNoteButton in NotesPage.xaml (Resources is
         not a DependencyProperty and cannot ride a Style setter). -->
    <Style x:Key="NewNoteButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{ThemeResource BrandAccentSubtleFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BrandAccentSubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource BrandAccentBrush}" />
    </Style>

    <!-- Note-list item hover delete badge (Qt parity: 24px warm-tinted circle).
         PointerOver/Pressed overrides inline on the badge in NotesPage.xaml. -->
    <Style x:Key="NoteItemDeleteButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{ThemeResource DangerSubtleFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DangerSubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource DangerGlyphBrush}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
</ResourceDictionary>
