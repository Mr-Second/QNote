<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:QNote.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:HexToBrushConverter x:Key="HexToBrush" />

    <!-- Shared, keyed styles. Reused across views, never copy-pasted per view. -->
    <Style x:Key="NoteTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Layered card panel floated over the window's Mica backdrop (rounded + stroke). -->
    <Style x:Key="PanelCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Compact editor-toolbar buttons (default template, subdued chrome).
         Checked state = soft accent tint + accent glyph (Qt parity: 5-10% tint,
         never a solid accent fill). `Resources` is NOT a DependencyProperty, so
         the checked-state theme-resource overrides live inline on the toolbar
         StackPanel in NotesPage.xaml (the style's only consumer). -->
    <Style x:Key="EditorToolbarToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="EditorToolbarButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- New-note button (Qt parity: soft accent tint circle, "+" in accent, never
         a solid accent fill in any state). PointerOver/Pressed theme-resource
         overrides live inline on NewNoteButton in NotesPage.xaml (Resources is
         not a DependencyProperty and cannot ride a Style setter). -->
    <Style x:Key="NewNoteButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{ThemeResource BrandAccentSubtleFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BrandAccentSubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource BrandAccentBrush}" />
    </Style>

    <!-- Note-list item hover delete badge (Qt parity: 24px warm-tinted circle).
         PointerOver/Pressed overrides inline on the badge in NotesPage.xaml. -->
    <Style x:Key="NoteItemDeleteButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{ThemeResource DangerSubtleFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DangerSubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource DangerGlyphBrush}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
</ResourceDictionary>
