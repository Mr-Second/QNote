<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:QNote.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:HexToBrushConverter x:Key="HexToBrush" />
    <conv:ListDensityConverter x:Key="ListDensity" />

    <!-- Shared, keyed styles. Reused across views, never copy-pasted per view. -->
    <Style x:Key="NoteTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Layered card panel floated over the window's Mica backdrop (rounded + stroke). -->
    <Style x:Key="PanelCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Editor-toolbar AppBar button styles moved to Themes/EditorToolbar.xaml
         (custom template — icon centered by construction). -->

    <!-- Fluent subtle actions: transparent at rest, with native hover/press fills. -->
    <Style x:Key="NoteHeaderActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Note-list item hover delete badge (Qt parity: 24px warm-tinted circle).
         PointerOver/Pressed overrides inline on the badge in NotesPage.xaml. -->
    <Style x:Key="NoteItemDeleteButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{ThemeResource DangerSubtleFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DangerSubtleBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource DangerGlyphBrush}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
</ResourceDictionary>
