<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Semantic brand tokens + a tech-blue accent override so the whole app (accent
        buttons, list selection) reads in QNote's identity color regardless of the
        user's system accent. Views reference these ThemeResource tokens, never raw
        hex. All three theme keys are provided; HighContrast maps to SystemColor* and
        deliberately does NOT override the accent (Windows contrast themes own it).
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BrandAccentBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="NoteSurfaceBrush" Color="#FFFDF7" />

            <!-- Todo (task 10-04): importance star amber + the middle-pane
                 gradient (a4 mockup, light variant) + hero text. 2026-10-15 user
                 ruling: the gradient paints the WHOLE middle pane (B area), so it
                 lives on TodoPaneBackgroundBrush and the hero band itself is
                 transparent (its white text rides the pane gradient). -->
            <SolidColorBrush x:Key="TodoStarBrush" Color="#EAA300" />
            <LinearGradientBrush
                x:Key="TodoPaneBackgroundBrush"
                StartPoint="0,0"
                EndPoint="0.34,0.94">
                <GradientStop Offset="0" Color="#2E8BA3" />
                <GradientStop Offset="0.38" Color="#6FB5B8" />
                <GradientStop Offset="0.55" Color="#A8CFC4" />
                <GradientStop Offset="0.80" Color="#F2B480" />
                <GradientStop Offset="1" Color="#EF8F6B" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="TodoHeroBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TodoHeroForegroundBrush" Color="#FFFFFF" />
            <!-- Opaque task-row cards (real To Do floats white rows on the list
                 background) — translucent rows let the gradient wash out the
                 hairline separators (user 2026-10-15). -->
            <SolidColorBrush x:Key="TodoRowBackgroundBrush" Color="#FFFFFFFF" />
            <!-- 已完成 accordion chip: translucent at rest, opaque on hover
                 (user 2026-10-15 — NOT the accent-blue ToggleButton default). -->
            <SolidColorBrush x:Key="TodoCompletedHeaderBrush" Color="#80FFFFFF" />

            <!-- Rebrand the Fluent accent to QNote tech-blue. -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#1A85D8" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#3494DC" />

            <!-- Soft accent tints (Qt parity: new-note button, toolbar checked state). -->
            <SolidColorBrush x:Key="BrandAccentSubtleFillBrush" Color="#1A0078D4" />
            <SolidColorBrush x:Key="BrandAccentSubtleFillHoverBrush" Color="#260078D4" />
            <SolidColorBrush x:Key="BrandAccentSubtleFillPressedBrush" Color="#330078D4" />
            <SolidColorBrush x:Key="BrandAccentSubtleBorderBrush" Color="#400078D4" />

            <!-- Warm danger tints (Qt parity: note-item hover delete badge). -->
            <SolidColorBrush x:Key="DangerSubtleFillBrush" Color="#CCFFF8F1" />
            <SolidColorBrush x:Key="DangerSubtleFillHoverBrush" Color="#FFF3E8" />
            <SolidColorBrush x:Key="DangerSubtleBorderBrush" Color="#22B78C6E" />
            <SolidColorBrush x:Key="DangerSubtleBorderHoverBrush" Color="#66C27E5D" />
            <SolidColorBrush x:Key="DangerGlyphBrush" Color="#C27E5D" />
            <SolidColorBrush x:Key="DangerGlyphHoverBrush" Color="#B86843" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BrandAccentBrush" Color="#4A9EFF" />
            <SolidColorBrush x:Key="NoteSurfaceBrush" Color="#2A2A2E" />

            <!-- Todo (task 10-04): dark pane gradient + star amber variant
                 (gradient paints the whole middle pane — see the Light note). -->
            <SolidColorBrush x:Key="TodoStarBrush" Color="#FFD164" />
            <LinearGradientBrush
                x:Key="TodoPaneBackgroundBrush"
                StartPoint="0,0"
                EndPoint="0.34,0.94">
                <GradientStop Offset="0" Color="#1D5B6E" />
                <GradientStop Offset="0.40" Color="#3F7D80" />
                <GradientStop Offset="0.58" Color="#5F8F83" />
                <GradientStop Offset="0.82" Color="#A3775A" />
                <GradientStop Offset="1" Color="#7C5148" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="TodoHeroBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TodoHeroForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TodoRowBackgroundBrush" Color="#FF2B2B2B" />
            <SolidColorBrush x:Key="TodoCompletedHeaderBrush" Color="#803A3A3A" />

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4A9EFF" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#5DA8FF" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#73B4FF" />

            <SolidColorBrush x:Key="BrandAccentSubtleFillBrush" Color="#1A4A9EFF" />
            <SolidColorBrush x:Key="BrandAccentSubtleFillHoverBrush" Color="#264A9EFF" />
            <SolidColorBrush x:Key="BrandAccentSubtleFillPressedBrush" Color="#334A9EFF" />
            <SolidColorBrush x:Key="BrandAccentSubtleBorderBrush" Color="#404A9EFF" />

            <SolidColorBrush x:Key="DangerSubtleFillBrush" Color="#26C27E5D" />
            <SolidColorBrush x:Key="DangerSubtleFillHoverBrush" Color="#40C27E5D" />
            <SolidColorBrush x:Key="DangerSubtleBorderBrush" Color="#40B78C6E" />
            <SolidColorBrush x:Key="DangerSubtleBorderHoverBrush" Color="#80C27E5D" />
            <SolidColorBrush x:Key="DangerGlyphBrush" Color="#D9A187" />
            <SolidColorBrush x:Key="DangerGlyphHoverBrush" Color="#EBBDA6" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="BrandAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NoteSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <!-- Todo: contrast themes own the colors — solid system highlight,
                  system text, no gradient (alpha-washed visuals vanish or glare in HC).
                  The pane stays the system window color; only the hero band is
                  highlighted (WindowText on HighlightColor would be unreadable
                  across the whole pane). -->
            <SolidColorBrush x:Key="TodoStarBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TodoPaneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TodoHeroBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TodoRowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TodoCompletedHeaderBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TodoHeroForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />

            <SolidColorBrush x:Key="BrandAccentSubtleFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BrandAccentSubtleFillHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BrandAccentSubtleFillPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BrandAccentSubtleBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="DangerSubtleFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DangerSubtleFillHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DangerSubtleBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerSubtleBorderHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DangerGlyphBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerGlyphHoverBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
