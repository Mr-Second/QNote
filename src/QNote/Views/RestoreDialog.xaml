<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="QNote.Views.RestoreDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:QNote.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:QNote.Views"
    x:Uid="RestoreDialog"
    Title="恢复数据"
    CloseButtonText="取消"
    DefaultButton="None"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonText="开始恢复"
    PrimaryButtonClick="OnPrimaryButtonClick"
    mc:Ignorable="d">

    <!-- Single dialog, sections revealed step by step: only ONE ContentDialog may
         be open at a time, so the pick → password → analyze → mode → run flow
         cannot span nested dialogs (xaml-guidelines). -->
    <!-- Grid wrapper lets the toast overlay the content (top-center). -->
    <Grid Width="420">
        <StackPanel x:Name="ContentRoot" Spacing="10">

        <!-- Step 1: pick the archive -->
        <StackPanel Spacing="4">
            <TextBlock x:Uid="RestoreFileLabel" Text="备份文件" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="FilePathText"
                    x:Uid="RestoreFilePath"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="未选择文件"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <Button
                    x:Name="PickButton"
                    x:Uid="RestorePickButton"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="RestorePickButton"
                    Click="Pick_Click"
                    Content="选择…" />
            </Grid>
        </StackPanel>

        <!-- Step 1b: automatic pre-restore backups (D4 safety net) — one click
             selects one, no folder browsing. Hidden when none exist. -->
        <StackPanel x:Name="AutoBackupsPanel" Spacing="4" Visibility="Collapsed">
            <TextBlock x:Uid="AutoBackupsLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="从自动备份恢复（覆盖恢复前自动创建）" />
            <ListView
                x:Name="AutoBackupsList"
                x:Uid="AutoBackupsList"
                MaxHeight="112"
                AutomationProperties.AutomationId="AutoBackupsList"
                IsItemClickEnabled="True"
                ItemClick="AutoBackup_Click"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:AutoBackupEntry">
                        <TextBlock Text="{x:Bind Display}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- Step 2: password (only when the archive is encrypted) -->
        <PasswordBox
            x:Name="PasswordBox"
            x:Uid="RestorePasswordBox"
            AutomationProperties.AutomationId="RestorePasswordBox"
            Header="备份密码（该备份已加密）"
            Visibility="Collapsed" />

        <Button
            x:Name="AnalyzeButton"
            x:Uid="RestoreAnalyzeButton"
            AutomationProperties.AutomationId="RestoreAnalyzeButton"
            Click="Analyze_Click"
            Content="分析备份"
            Visibility="Collapsed" />

        <!-- Step 3: conflict analysis + mode. The mode items are RadioButtons
             (x:String items cannot carry x:Uid); SelectedIndex semantics are
             unchanged. -->
        <StackPanel
            x:Name="AnalysisPanel"
            Spacing="8"
            Visibility="Collapsed">
            <TextBlock x:Name="CountsText" TextWrapping="Wrap" />
            <RadioButtons
                x:Name="ModeRadios"
                x:Uid="RestoreModeRadios"
                AutomationProperties.AutomationId="RestoreModeRadios"
                SelectedIndex="1"
                SelectionChanged="ModeRadios_SelectionChanged">
                <RadioButton x:Uid="RestoreModeOverwrite" Content="覆盖：完全替换当前数据（会先自动备份当前数据）" />
                <RadioButton x:Uid="RestoreModeMerge" Content="合并：冲突便签保留较新版本，并导入新便签" />
                <RadioButton x:Uid="RestoreModeImportNew" Content="仅导入新增：只导入当前不存在的便签" />
            </RadioButtons>
            <TextBlock
                x:Name="OverwriteWarning"
                x:Uid="OverwriteWarning"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="覆盖将删除当前全部便签、分类和设置，替换为备份内容。"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>

        <ProgressBar
            x:Name="WorkingBar"
            Maximum="1"
            Visibility="Collapsed" />
        </StackPanel>

        <!-- Floating toast for in-dialog (pick/analysis) failures; the final
             outcome is reported by the caller as a page-level toast after close. -->
        <controls:AppToast
            x:Name="ResultTip"
            Margin="0,2,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top" />
    </Grid>
</ContentDialog>
