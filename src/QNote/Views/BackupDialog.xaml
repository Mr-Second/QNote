<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="QNote.Views.BackupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:QNote.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="BackupDialog"
    Title="备份数据"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonText="开始备份"
    PrimaryButtonClick="OnPrimaryButtonClick"
    mc:Ignorable="d">

    <!-- Grid wrapper lets the toast overlay the content (top-center) instead of
         taking layout space. Fixed compact width (same reason as CategoryEditDialog). -->
    <Grid Width="400">
        <StackPanel x:Name="ContentRoot" Spacing="10">
        <TextBlock x:Uid="BackupDescription" Text="包含全部便签、分类、设置和原始图片。备份为单个 .qns 文件（ZIP，可选 AES-256 加密）。" TextWrapping="Wrap" />

        <StackPanel Spacing="4">
            <TextBlock x:Uid="BackupLocationLabel" Text="保存位置" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="PathBox"
                    x:Uid="BackupPathBox"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="BackupPathBox" />
                <Button
                    x:Name="BrowseButton"
                    x:Uid="BackupBrowseButton"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="BackupBrowseButton"
                    Click="Browse_Click"
                    Content="浏览…" />
            </Grid>
        </StackPanel>

        <PasswordBox
            x:Name="PasswordBox"
            x:Uid="BackupPasswordBox"
            AutomationProperties.AutomationId="BackupPasswordBox"
            Header="密码（可选，留空则不加密）" />
        <PasswordBox
            x:Name="ConfirmBox"
            x:Uid="BackupConfirmBox"
            AutomationProperties.AutomationId="BackupPasswordConfirmBox"
            Header="确认密码" />

        <ProgressBar
            x:Name="WorkingBar"
            IsIndeterminate="True"
            Visibility="Collapsed" />
        </StackPanel>

        <!-- Floating toast for in-dialog (pre-run validation) failures; the final
             outcome is reported by the caller as a page-level toast after close. -->
        <controls:AppToast
            x:Name="ResultTip"
            Margin="0,2,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top" />
    </Grid>
</ContentDialog>
