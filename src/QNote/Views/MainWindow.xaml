<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="QNote.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:QNote.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    Title="QNote"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tray icon lives in the visual tree but renders nothing (no template). -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ContextMenuMode="SecondWindow"
            DoubleClickCommand="{x:Bind ShowWindowCommand}"
            IconSource="ms-appx:///Assets/AppIcon.ico"
            ToolTipText="QNote">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout x:Name="TrayMenuFlyout" Opened="TrayMenu_Opened">
                    <MenuFlyoutItem x:Name="TrayShowItem" x:Uid="TrayShowItem" Click="TrayShow_Click" Text="显示窗口" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="TrayQuitItem" x:Uid="TrayQuitItem" Click="TrayQuit_Click" Text="退出" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <TitleBar x:Name="AppTitleBar" Title="QNote">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/TitleBarIcon.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- The Frame hosts pages. Add screen UI as Pages, not here. -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
