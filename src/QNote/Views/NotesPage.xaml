<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="QNote.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:QNote.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:QNote.ViewModels"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Page.Resources>
        <ThemeShadow x:Key="PanelShadow" />
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="S"
            Modifiers="Control"
            Invoked="SaveAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Margin="12" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!--  ============ Sidebar (static this slice) ============  -->
        <Border
            Grid.Column="0"
            Style="{StaticResource PanelCardStyle}"
            Shadow="{StaticResource PanelShadow}"
            Translation="0,0,12">
            <Grid Padding="10" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="1">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="QNote" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="便签整理" />
                </StackPanel>

                <!--  Category list: synthetic "全部" pinned at index 0 (same control,
                      same template as DB rows — visual parity by construction)  -->
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <ListView
                        x:Name="CategoryList"
                        AllowDrop="True"
                        CanDragItems="True"
                        CanReorderItems="True"
                        DragItemsCompleted="CategoryList_DragItemsCompleted"
                        DragItemsStarting="CategoryList_DragItemsStarting"
                        ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Padding" Value="6,6" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryItemViewModel">
                                <Grid Height="28">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Click="RenameCategoryMenu_Click"
                                                IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                                Tag="{x:Bind}"
                                                Text="重命名">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontSize="12" Glyph="&#xE70F;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                Click="DeleteCategoryMenu_Click"
                                                IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                                Tag="{x:Bind}"
                                                Text="删除">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Border
                                        Width="3"
                                        Height="16"
                                        Margin="0,0,0,0"
                                        HorizontalAlignment="Left"
                                        Background="{x:Bind ColorHex, Converter={StaticResource HexToBrush}, Mode=OneWay}"
                                        CornerRadius="2"
                                        Visibility="{x:Bind IsSelected, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                                    <Grid Margin="10,0,6,0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{x:Bind ActiveColorHex, Converter={StaticResource HexToBrush}, Mode=OneWay}"
                                            Glyph="{x:Bind IconGlyph, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{x:Bind ActiveColorHex, Converter={StaticResource HexToBrush}, Mode=OneWay}"
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{x:Bind ActiveColorHex, Converter={StaticResource HexToBrush}, Mode=OneWay}"
                                            Text="{x:Bind CountText, Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <StackPanel Grid.Row="2" Spacing="2">
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        AutomationProperties.Name="新建分类"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NewCategoryButton_Click"
                        ToolTipService.ToolTip="新建分类">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="新建分类" />
                        </StackPanel>
                    </Button>
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        AutomationProperties.Name="设置"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="SettingsButton_Click"
                        ToolTipService.ToolTip="设置">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE713;" />
                            <TextBlock Text="设置" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  ============ Note list ============  -->
        <Border
            Grid.Column="1"
            Style="{StaticResource PanelCardStyle}"
            Shadow="{StaticResource PanelShadow}"
            Translation="0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Padding="14,12,10,10"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.CurrentCategoryTitle, Mode=OneWay}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="便签摘要" />
                    </StackPanel>
                    <Button
                        x:Name="NewNoteButton"
                        Grid.Column="1"
                        Width="34"
                        Height="34"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="新建便签"
                        Command="{x:Bind ViewModel.NewNoteCommand}"
                        CornerRadius="17"
                        Style="{StaticResource NewNoteButtonStyle}"
                        ToolTipService.ToolTip="新建便签">
                        <!-- Per-state overrides ride the default Button template's theme
                             resources; inline per-theme so runtime theme switches stay
                             correct and no state shows a solid accent fill. -->
                        <Button.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Light">
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="BrandAccentSubtleFillHoverBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="BrandAccentSubtleFillPressedBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="BrandAccentSubtleBorderBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="BrandAccentSubtleBorderBrush" />
                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="BrandAccentBrush" />
                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="BrandAccentBrush" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Dark">
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="BrandAccentSubtleFillHoverBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="BrandAccentSubtleFillPressedBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="BrandAccentSubtleBorderBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="BrandAccentSubtleBorderBrush" />
                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="BrandAccentBrush" />
                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="BrandAccentBrush" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="BrandAccentSubtleFillHoverBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="BrandAccentSubtleFillPressedBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="BrandAccentSubtleBorderBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="BrandAccentSubtleBorderBrush" />
                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="BrandAccentBrush" />
                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="BrandAccentBrush" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Button.Resources>
                        <TextBlock FontSize="18" FontWeight="Medium" Text="+" />
                    </Button>
                </Grid>

                <!--  Search box (as-you-type, debounced in the VM) + funnel button
                      for result ordering (visible only while searching).  -->
                <Grid
                    Grid.Row="1"
                    Margin="10,0,10,4"
                    ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        Padding="10,6"
                        AutomationProperties.Name="搜索便签"
                        PlaceholderText="搜索便签"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="SearchSortButton"
                        AutomationProperties.Name="搜索排序"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="搜索结果排序"
                        Visibility="{x:Bind ViewModel.IsSearching, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="&#xE71C;" />
                        <Button.Flyout>
                            <!-- Check mark rides the right-aligned accelerator slot
                                 (KeyboardAcceleratorTextOverride) instead of the
                                 left radio bullet. -->
                            <MenuFlyout Opened="SearchSortFlyout_Opened" Placement="Bottom">
                                <MenuFlyoutItem
                                    x:Name="SortByRelevanceItem"
                                    Click="SearchSortItem_Click"
                                    Tag="0"
                                    Text="按匹配度" />
                                <MenuFlyoutItem
                                    x:Name="SortByNewestItem"
                                    Click="SearchSortItem_Click"
                                    Tag="1"
                                    Text="最新优先" />
                                <MenuFlyoutItem
                                    x:Name="SortByOldestItem"
                                    Click="SearchSortItem_Click"
                                    Tag="2"
                                    Text="最早优先" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <ListView
                    x:Name="NotesList"
                    Grid.Row="2"
                    Padding="8,0,8,8"
                    ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedNote, Mode=TwoWay}"
                    SelectionChanged="NotesList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NoteItemViewModel">
                            <!-- Row metrics come from the density setting (padding lives
                                 here, not in the container style, so it can bind). -->
                            <Grid
                                Padding="{x:Bind Density, Converter={StaticResource ListDensity}, ConverterParameter=Padding, Mode=OneWay}"
                                PointerEntered="NoteItem_PointerEntered"
                                PointerExited="NoteItem_PointerExited">
                                <StackPanel Spacing="{x:Bind Density, Converter={StaticResource ListDensity}, ConverterParameter=Spacing, Mode=OneWay}">
                                    <TextBlock
                                        controls:TextBlockHighlighter.Keyword="{x:Bind Keyword, Mode=OneWay}"
                                        controls:TextBlockHighlighter.Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                        Margin="0,0,26,0"
                                        FontSize="14"
                                        Style="{StaticResource NoteTitleTextStyle}" />
                                    <TextBlock
                                        controls:TextBlockHighlighter.Keyword="{x:Bind Keyword, Mode=OneWay}"
                                        controls:TextBlockHighlighter.Text="{x:Bind Preview, Mode=OneWay}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind TimeDisplay, Mode=OneWay}" />
                                </StackPanel>
                                <!-- Hover-reveal delete badge (Qt parity: delete lives on the item, not the editor). -->
                                <Button
                                    x:Name="ItemDeleteButton"
                                    Width="24"
                                    Height="24"
                                    Margin="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="删除便签"
                                    Click="ItemDeleteButton_Click"
                                    Style="{StaticResource NoteItemDeleteButtonStyle}"
                                    ToolTipService.ToolTip="删除便签"
                                    Visibility="Collapsed">
                                    <!-- Warm-tinted hover/press states (default Button template
                                         theme resources, per-theme for runtime theme switches). -->
                                    <Button.Resources>
                                        <ResourceDictionary>
                                            <ResourceDictionary.ThemeDictionaries>
                                                <ResourceDictionary x:Key="Light">
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="DangerSubtleFillHoverBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="DangerSubtleFillHoverBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="DangerSubtleBorderHoverBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="DangerSubtleBorderHoverBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="DangerGlyphHoverBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="DangerGlyphHoverBrush" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="Dark">
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="DangerSubtleFillHoverBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="DangerSubtleFillHoverBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="DangerSubtleBorderHoverBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="DangerSubtleBorderHoverBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="DangerGlyphHoverBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="DangerGlyphHoverBrush" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="HighContrast">
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="DangerSubtleFillHoverBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="DangerSubtleFillHoverBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="DangerSubtleBorderHoverBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="DangerSubtleBorderHoverBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="DangerGlyphHoverBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="DangerGlyphHoverBrush" />
                                                </ResourceDictionary>
                                            </ResourceDictionary.ThemeDictionaries>
                                        </ResourceDictionary>
                                    </Button.Resources>
                                    <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="暂无便签"
                    Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />

                <Border
                    Grid.Row="3"
                    Padding="14,6"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                </Border>
            </Grid>
        </Border>

        <!--  ============ Editor ============  -->
        <Border
            Grid.Column="2"
            Background="{ThemeResource NoteSurfaceBrush}"
            Shadow="{StaticResource PanelShadow}"
            Style="{StaticResource PanelCardStyle}"
            Translation="0,0,28">
            <Grid>
                <!--  Empty state  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}">
                    <FontIcon
                        FontSize="42"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE8A5;" />
                    <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="选择或创建一个便签" />
                </StackPanel>

                <!--  Editor  -->
                <Grid Padding="20,16" Visibility="{x:Bind ViewModel.HasSelection, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            Grid.Column="0"
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource BrandAccentBrush}"
                            ToolTipService.ToolTip="未保存"
                            Visibility="{x:Bind ViewModel.IsDirty, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        <TextBox
                            x:Name="TitleBox"
                            Grid.Column="1"
                            Padding="0"
                            AutomationProperties.Name="便签标题"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            FontWeight="SemiBold"
                            PlaceholderText="无标题便签"
                            Text="{x:Bind ViewModel.EditingTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <!-- Kill default focus visuals in every state: paper surface stays borderless. -->
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Margin="0,10"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0" />

                    <!--  Formatting toolbar: CommandBar with dynamic overflow — commands that
                          don't fit move into the "..." overflow menu and back as the width
                          changes (no more hidden horizontal scrollbar).
                          DynamicOverflowOrder semantics (verified empirically on WinUI 2.3.6):
                          LOWER values overflow FIRST, higher values stay on the bar longest
                          (MS docs only state "equal values move together"). Rightmost items
                          get the smallest orders so the bar collapses right-to-left; the two
                          ComboBoxes are pinned at 0 via AppBarElementContainer — containers
                          never overflow (locked PRD decision: they stay on the bar).  -->
                    <CommandBar
                        x:Name="FormatBar"
                        Grid.Row="2"
                        Background="Transparent"
                        DefaultLabelPosition="Collapsed"
                        IsDynamicOverflowEnabled="True"
                        Opened="FormatBar_Opened"
                        SizeChanged="FormatBar_SizeChanged">
                        <!-- Checked-state overrides for every on-bar AppBarToggleButton:
                             soft accent tint + accent glyph, no border, never a solid accent
                             fill (Qt parity). Same key family as the old ToggleButton
                             overrides — verified against the WinUI 2.3.6 generic.xaml
                             DefaultAppBarToggleButtonStyle template (Checked states read
                             AppBarToggleButton{Background,Foreground,BorderBrush}Checked*).
                             ThemeDictionaries (not plain aliases) so theme switches re-resolve
                             the Brand* brushes. Overflow items live in a popup and do NOT see
                             these scoped overrides — they keep the stock checked look. -->
                        <CommandBar.Resources>
                            <ResourceDictionary>
                                <!-- Compact metrics (user acceptance: the stock ~40px bar and
                                     loose margins read 喧宾夺主 next to the editor). These keys
                                     are read by the CommandBar/AppBarButton templates from the
                                     visual-tree walk, so scoping them here hits this bar only:
                                     28px bar row, 14px glyphs, tight inner margins, slim "...".
                                     Theme-invariant, so they live outside the ThemeDictionaries. -->
                                <x:Double x:Key="AppBarThemeCompactHeight">28</x:Double>
                                <x:Double x:Key="AppBarButtonContentHeight">14</x:Double>
                                <Thickness x:Key="AppBarButtonInnerBorderCompactMargin">2</Thickness>
                                <Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,2</Thickness>
                                <Thickness x:Key="CommandBarMoreButtonMargin">6,0</Thickness>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Light">
                                        <StaticResource x:Key="AppBarToggleButtonBackgroundChecked" ResourceKey="BrandAccentSubtleFillBrush" />
                                        <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" ResourceKey="BrandAccentSubtleFillHoverBrush" />
                                        <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPressed" ResourceKey="BrandAccentSubtleFillPressedBrush" />
                                        <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedDisabled" ResourceKey="BrandAccentSubtleFillBrush" />
                                        <StaticResource x:Key="AppBarToggleButtonForegroundChecked" ResourceKey="BrandAccentBrush" />
                                        <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPointerOver" ResourceKey="BrandAccentBrush" />
                                        <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPressed" ResourceKey="BrandAccentBrush" />
                                        <SolidColorBrush x:Key="AppBarToggleButtonBorderBrushChecked" Color="Transparent" />
                                        <SolidColorBrush x:Key="AppBarToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="AppBarToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Dark">
                                        <StaticResource x:Key="AppBarToggleButtonBackgroundChecked" ResourceKey="BrandAccentSubtleFillBrush" />
                                        <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" ResourceKey="BrandAccentSubtleFillHoverBrush" />
                                        <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPressed" ResourceKey="BrandAccentSubtleFillPressedBrush" />
                                        <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedDisabled" ResourceKey="BrandAccentSubtleFillBrush" />
                                        <StaticResource x:Key="AppBarToggleButtonForegroundChecked" ResourceKey="BrandAccentBrush" />
                                        <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPointerOver" ResourceKey="BrandAccentBrush" />
                                        <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPressed" ResourceKey="BrandAccentBrush" />
                                        <SolidColorBrush x:Key="AppBarToggleButtonBorderBrushChecked" Color="Transparent" />
                                        <SolidColorBrush x:Key="AppBarToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="AppBarToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <StaticResource x:Key="AppBarToggleButtonBackgroundChecked" ResourceKey="BrandAccentSubtleFillBrush" />
                                        <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" ResourceKey="BrandAccentSubtleFillHoverBrush" />
                                        <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPressed" ResourceKey="BrandAccentSubtleFillPressedBrush" />
                                        <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedDisabled" ResourceKey="BrandAccentSubtleFillBrush" />
                                        <StaticResource x:Key="AppBarToggleButtonForegroundChecked" ResourceKey="BrandAccentBrush" />
                                        <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPointerOver" ResourceKey="BrandAccentBrush" />
                                        <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPressed" ResourceKey="BrandAccentBrush" />
                                        <SolidColorBrush x:Key="AppBarToggleButtonBorderBrushChecked" Color="Transparent" />
                                        <SolidColorBrush x:Key="AppBarToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="AppBarToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </CommandBar.Resources>

                        <AppBarToggleButton
                            x:Name="BoldButton"
                            AutomationProperties.Name="粗体"
                            DynamicOverflowOrder="15"
                            Style="{StaticResource EditorToolbarAppBarToggleButtonStyle}"
                            IsThreeState="True"
                            Label="粗体"
                            Click="BoldButton_Click"
                            ToolTipService.ToolTip="粗体">
                            <AppBarToggleButton.Icon>
                                <FontIcon Glyph="&#xE8DD;" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                        <AppBarToggleButton
                            x:Name="ItalicButton"
                            AutomationProperties.Name="斜体"
                            DynamicOverflowOrder="14"
                            Style="{StaticResource EditorToolbarAppBarToggleButtonStyle}"
                            IsThreeState="True"
                            Label="斜体"
                            Click="ItalicButton_Click"
                            ToolTipService.ToolTip="斜体">
                            <AppBarToggleButton.Icon>
                                <FontIcon Glyph="&#xE8DB;" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                        <AppBarToggleButton
                            x:Name="UnderlineButton"
                            AutomationProperties.Name="下划线"
                            DynamicOverflowOrder="13"
                            Style="{StaticResource EditorToolbarAppBarToggleButtonStyle}"
                            IsThreeState="True"
                            Label="下划线"
                            Click="UnderlineButton_Click"
                            ToolTipService.ToolTip="下划线">
                            <AppBarToggleButton.Icon>
                                <FontIcon Glyph="&#xE8DC;" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                        <AppBarToggleButton
                            x:Name="StrikethroughButton"
                            AutomationProperties.Name="删除线"
                            DynamicOverflowOrder="12"
                            Style="{StaticResource EditorToolbarAppBarToggleButtonStyle}"
                            IsThreeState="True"
                            Label="删除线"
                            Click="StrikethroughButton_Click"
                            ToolTipService.ToolTip="删除线">
                            <AppBarToggleButton.Icon>
                                <FontIcon Glyph="&#xE8E0;" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>

                        <AppBarSeparator DynamicOverflowOrder="16" Margin="3,0" />

                        <AppBarElementContainer DynamicOverflowOrder="0">
                            <ComboBox
                                x:Name="FontFamilyBox"
                                Width="124"
                                Height="26"
                                MinHeight="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="字体"
                                SelectionChanged="FontFamilyBox_SelectionChanged"
                                ToolTipService.ToolTip="字体" />
                        </AppBarElementContainer>
                        <AppBarElementContainer DynamicOverflowOrder="0">
                            <ComboBox
                                x:Name="FontSizeBox"
                                Width="64"
                                Height="26"
                                MinHeight="0"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="字号"
                                SelectionChanged="FontSizeBox_SelectionChanged"
                                ToolTipService.ToolTip="字号" />
                        </AppBarElementContainer>

                        <AppBarSeparator DynamicOverflowOrder="11" Margin="3,0" />

                        <AppBarButton
                            x:Name="ColorButton"
                            AutomationProperties.Name="文字颜色"
                            DynamicOverflowOrder="10"
                            Style="{StaticResource EditorToolbarAppBarButtonStyle}"
                            Label="文字颜色"
                            ToolTipService.ToolTip="文字颜色">
                            <AppBarButton.Icon>
                                <!-- Current text color rides the icon's Foreground (set in
                                     UpdateToolbarState) — the FontColor glyph is an "A" over a
                                     bar, so a colored glyph preserves the old swatch cue.
                                     No explicit Foreground here: it must inherit the themed
                                     button foreground until a color is applied. -->
                                <FontIcon x:Name="ColorButtonIcon" Glyph="&#xE8D3;" />
                            </AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <Flyout>
                                    <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
                                        <GridView
                                            x:Name="ColorGrid"
                                            Width="288"
                                            IsItemClickEnabled="True"
                                            ItemClick="ColorGrid_ItemClick"
                                            SelectionMode="None">
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="controls:PaletteColor">
                                                    <Border
                                                        Width="24"
                                                        Height="24"
                                                        Margin="2"
                                                        AutomationProperties.Name="{x:Bind Name}"
                                                        Background="{x:Bind Brush}"
                                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        ToolTipService.ToolTip="{x:Bind Name}" />
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </ScrollViewer>
                                </Flyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>

                        <AppBarSeparator DynamicOverflowOrder="9" Margin="3,0" />

                        <AppBarToggleButton
                            x:Name="AlignLeftButton"
                            AutomationProperties.Name="左对齐"
                            DynamicOverflowOrder="8"
                            Style="{StaticResource EditorToolbarAppBarToggleButtonStyle}"
                            Label="左对齐"
                            Click="AlignLeftButton_Click"
                            ToolTipService.ToolTip="左对齐">
                            <AppBarToggleButton.Icon>
                                <FontIcon Glyph="&#xE8E4;" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                        <AppBarToggleButton
                            x:Name="AlignCenterButton"
                            AutomationProperties.Name="居中对齐"
                            DynamicOverflowOrder="7"
                            Style="{StaticResource EditorToolbarAppBarToggleButtonStyle}"
                            Label="居中对齐"
                            Click="AlignCenterButton_Click"
                            ToolTipService.ToolTip="居中对齐">
                            <AppBarToggleButton.Icon>
                                <FontIcon Glyph="&#xE8E3;" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                        <AppBarToggleButton
                            x:Name="AlignRightButton"
                            AutomationProperties.Name="右对齐"
                            DynamicOverflowOrder="6"
                            Style="{StaticResource EditorToolbarAppBarToggleButtonStyle}"
                            Label="右对齐"
                            Click="AlignRightButton_Click"
                            ToolTipService.ToolTip="右对齐">
                            <AppBarToggleButton.Icon>
                                <FontIcon Glyph="&#xE8E2;" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>

                        <AppBarSeparator DynamicOverflowOrder="5" Margin="3,0" />

                        <AppBarToggleButton
                            x:Name="BulletListButton"
                            AutomationProperties.Name="无序列表"
                            DynamicOverflowOrder="4"
                            Style="{StaticResource EditorToolbarAppBarToggleButtonStyle}"
                            IsThreeState="True"
                            Label="无序列表"
                            Click="BulletListButton_Click"
                            ToolTipService.ToolTip="无序列表">
                            <AppBarToggleButton.Icon>
                                <FontIcon Glyph="&#xE8FD;" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>
                        <AppBarToggleButton
                            x:Name="NumberListButton"
                            AutomationProperties.Name="有序列表"
                            DynamicOverflowOrder="3"
                            Style="{StaticResource EditorToolbarAppBarToggleButtonStyle}"
                            IsThreeState="True"
                            Label="有序列表"
                            Click="NumberListButton_Click"
                            ToolTipService.ToolTip="有序列表">
                            <AppBarToggleButton.Icon>
                                <FontIcon Glyph="&#xE8FC;" />
                            </AppBarToggleButton.Icon>
                        </AppBarToggleButton>

                        <AppBarSeparator DynamicOverflowOrder="2" Margin="3,0" />

                        <AppBarButton
                            x:Name="InsertImageButton"
                            AutomationProperties.Name="插入图片"
                            DynamicOverflowOrder="1"
                            Style="{StaticResource EditorToolbarAppBarButtonStyle}"
                            Label="插入图片"
                            Click="InsertImageButton_Click"
                            ToolTipService.ToolTip="插入图片">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xEB9F;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>

                    <Border
                        Grid.Row="3"
                        Margin="0,10,0,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <RichEditBox
                                x:Name="ContentEditor"
                                Padding="0,10,0,0"
                                AllowDrop="True"
                                AutomationProperties.Name="便签内容"
                                Background="Transparent"
                                BorderThickness="0"
                                DragOver="ContentEditor_DragOver"
                                Drop="ContentEditor_Drop"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <!-- Kill default focus visuals in every state: paper surface stays borderless. -->
                                <RichEditBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </RichEditBox.Resources>
                            </RichEditBox>
                            <TextBlock
                                x:Name="ContentPlaceholder"
                                Margin="0,10,0,0"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                IsHitTestVisible="False"
                                Text="在这里输入便签内容..." />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Page-level floating toast for backup/restore final outcomes
             (success=green / failure=red card, auto-dismiss). -->
        <controls:AppToast
            x:Name="ResultTip"
            Grid.ColumnSpan="3"
            Margin="0,2,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top" />
    </Grid>
</Page>
