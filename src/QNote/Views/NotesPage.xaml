<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="QNote.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:QNote.ViewModels"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Page.Resources>
        <ThemeShadow x:Key="PanelShadow" />
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="S"
            Modifiers="Control"
            Invoked="SaveAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Margin="12" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!--  ============ Sidebar (static this slice) ============  -->
        <Border
            Grid.Column="0"
            Style="{StaticResource PanelCardStyle}"
            Shadow="{StaticResource PanelShadow}"
            Translation="0,0,12">
            <Grid Padding="10" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="1">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="QNote" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="便签整理" />
                </StackPanel>

                <!--  Static "全部" entry with a selected look  -->
                <Grid
                    Grid.Row="1"
                    Height="40"
                    Margin="0,6,0,0"
                    VerticalAlignment="Top"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="6">
                    <Border
                        Width="3"
                        Height="18"
                        Margin="3,0,0,0"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource BrandAccentBrush}"
                        CornerRadius="2" />
                    <StackPanel
                        Margin="14,0,8,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <FontIcon
                            FontSize="15"
                            Foreground="{ThemeResource BrandAccentBrush}"
                            Glyph="&#xE8FD;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="全部" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Spacing="2">
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        IsEnabled="False"
                        ToolTipService.ToolTip="即将推出">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="新建分类" />
                        </StackPanel>
                    </Button>
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        IsEnabled="False"
                        ToolTipService.ToolTip="即将推出">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE713;" />
                            <TextBlock Text="设置" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  ============ Note list ============  -->
        <Border
            Grid.Column="1"
            Style="{StaticResource PanelCardStyle}"
            Shadow="{StaticResource PanelShadow}"
            Translation="0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Padding="14,12,10,10"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="全部" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="便签摘要" />
                    </StackPanel>
                    <Button
                        x:Name="NewNoteButton"
                        Grid.Column="1"
                        Width="34"
                        Height="34"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="新建便签"
                        Command="{x:Bind ViewModel.NewNoteCommand}"
                        CornerRadius="17"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="新建便签">
                        <FontIcon FontSize="15" Glyph="&#xE710;" />
                    </Button>
                </Grid>

                <ListView
                    x:Name="NotesList"
                    Grid.Row="1"
                    Padding="8,0,8,8"
                    ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedNote, Mode=TwoWay}"
                    SelectionChanged="NotesList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NoteItemViewModel">
                            <StackPanel Spacing="3">
                                <TextBlock
                                    FontSize="14"
                                    Style="{StaticResource NoteTitleTextStyle}"
                                    Text="{x:Bind DisplayTitle, Mode=OneWay}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    Text="{x:Bind Preview, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind TimeDisplay, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="暂无便签"
                    Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />

                <Border
                    Grid.Row="2"
                    Padding="14,6"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                </Border>
            </Grid>
        </Border>

        <!--  ============ Editor ============  -->
        <Border
            Grid.Column="2"
            Background="{ThemeResource NoteSurfaceBrush}"
            Shadow="{StaticResource PanelShadow}"
            Style="{StaticResource PanelCardStyle}"
            Translation="0,0,28">
            <Grid>
                <!--  Empty state  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}">
                    <FontIcon
                        FontSize="42"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE8A5;" />
                    <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="选择或创建一个便签" />
                </StackPanel>

                <!--  Editor  -->
                <Grid Padding="20,16" Visibility="{x:Bind ViewModel.HasSelection, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            Grid.Column="0"
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource BrandAccentBrush}"
                            ToolTipService.ToolTip="未保存"
                            Visibility="{x:Bind ViewModel.IsDirty, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        <TextBox
                            x:Name="TitleBox"
                            Grid.Column="1"
                            Padding="0"
                            AutomationProperties.Name="便签标题"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            FontWeight="SemiBold"
                            PlaceholderText="无标题便签"
                            Text="{x:Bind ViewModel.EditingTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            x:Name="DeleteButton"
                            Grid.Column="2"
                            Width="34"
                            Height="34"
                            Padding="0"
                            AutomationProperties.Name="删除便签"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="DeleteButton_Click"
                            ToolTipService.ToolTip="删除便签">
                            <FontIcon FontSize="15" Glyph="&#xE74D;" />
                        </Button>
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.SelectedTimeDisplay, Mode=OneWay}" />

                    <Border
                        Grid.Row="2"
                        Margin="0,10"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0" />

                    <TextBox
                        x:Name="ContentBox"
                        Grid.Row="3"
                        Padding="0"
                        AcceptsReturn="True"
                        AutomationProperties.Name="便签内容"
                        Background="Transparent"
                        BorderThickness="0"
                        PlaceholderText="在这里输入便签内容..."
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Text="{x:Bind ViewModel.EditingContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
