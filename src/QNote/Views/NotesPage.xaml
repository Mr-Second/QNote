<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="QNote.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:QNote.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:QNote.ViewModels"
    xmlns:wre="using:WinUIRichEditor.Controls"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Page.Resources>
        <ThemeShadow x:Key="PanelShadow" />
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="S"
            Modifiers="Control"
            Invoked="SaveAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Margin="12" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!--  ============ Sidebar (static this slice) ============  -->
        <Border
            Grid.Column="0"
            Style="{StaticResource PanelCardStyle}"
            Shadow="{StaticResource PanelShadow}"
            Translation="0,0,12">
            <Grid Padding="10" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="1">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="QNote" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="便签整理" />
                </StackPanel>

                <!--  Category list: synthetic "全部" pinned at index 0 (same control,
                      same template as DB rows — visual parity by construction)  -->
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <ListView
                        x:Name="CategoryList"
                        AllowDrop="True"
                        CanDragItems="True"
                        CanReorderItems="True"
                        DragItemsCompleted="CategoryList_DragItemsCompleted"
                        DragItemsStarting="CategoryList_DragItemsStarting"
                        ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Padding" Value="6,6" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CategoryItemViewModel">
                                <Grid Height="28">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Click="RenameCategoryMenu_Click"
                                                IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                                Tag="{x:Bind}"
                                                Text="重命名">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontSize="12" Glyph="&#xE70F;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                Click="DeleteCategoryMenu_Click"
                                                IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                                Tag="{x:Bind}"
                                                Text="删除">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Border
                                        Width="3"
                                        Height="16"
                                        Margin="0,0,0,0"
                                        HorizontalAlignment="Left"
                                        Background="{x:Bind ColorHex, Converter={StaticResource HexToBrush}, Mode=OneWay}"
                                        CornerRadius="2"
                                        Visibility="{x:Bind IsSelected, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                                    <Grid Margin="10,0,6,0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{x:Bind ActiveColorHex, Converter={StaticResource HexToBrush}, Mode=OneWay}"
                                            Glyph="{x:Bind IconGlyph, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{x:Bind ActiveColorHex, Converter={StaticResource HexToBrush}, Mode=OneWay}"
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{x:Bind ActiveColorHex, Converter={StaticResource HexToBrush}, Mode=OneWay}"
                                            Text="{x:Bind CountText, Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <StackPanel Grid.Row="2" Spacing="2">
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        AutomationProperties.Name="新建分类"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NewCategoryButton_Click"
                        ToolTipService.ToolTip="新建分类">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="新建分类" />
                        </StackPanel>
                    </Button>
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        AutomationProperties.Name="设置"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="SettingsButton_Click"
                        ToolTipService.ToolTip="设置">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE713;" />
                            <TextBlock Text="设置" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  ============ Note list ============  -->
        <Border
            Grid.Column="1"
            Style="{StaticResource PanelCardStyle}"
            Shadow="{StaticResource PanelShadow}"
            Translation="0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Padding="14,12,10,10"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.CurrentCategoryTitle, Mode=OneWay}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="便签摘要" />
                    </StackPanel>
                    <Button
                        x:Name="NewNoteButton"
                        Grid.Column="1"
                        Width="34"
                        Height="34"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="新建便签"
                        Command="{x:Bind ViewModel.NewNoteCommand}"
                        CornerRadius="17"
                        Style="{StaticResource NewNoteButtonStyle}"
                        ToolTipService.ToolTip="新建便签">
                        <!-- Per-state overrides ride the default Button template's theme
                             resources; inline per-theme so runtime theme switches stay
                             correct and no state shows a solid accent fill. -->
                        <Button.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Light">
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="BrandAccentSubtleFillHoverBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="BrandAccentSubtleFillPressedBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="BrandAccentSubtleBorderBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="BrandAccentSubtleBorderBrush" />
                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="BrandAccentBrush" />
                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="BrandAccentBrush" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Dark">
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="BrandAccentSubtleFillHoverBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="BrandAccentSubtleFillPressedBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="BrandAccentSubtleBorderBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="BrandAccentSubtleBorderBrush" />
                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="BrandAccentBrush" />
                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="BrandAccentBrush" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="BrandAccentSubtleFillHoverBrush" />
                                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="BrandAccentSubtleFillPressedBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="BrandAccentSubtleBorderBrush" />
                                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="BrandAccentSubtleBorderBrush" />
                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="BrandAccentBrush" />
                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="BrandAccentBrush" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Button.Resources>
                        <TextBlock FontSize="18" FontWeight="Medium" Text="+" />
                    </Button>
                </Grid>

                <!--  Search box (as-you-type, debounced in the VM) + funnel button
                      for result ordering (visible only while searching).  -->
                <Grid
                    Grid.Row="1"
                    Margin="10,0,10,4"
                    ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        Padding="10,6"
                        AutomationProperties.Name="搜索便签"
                        PlaceholderText="搜索便签"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="SearchSortButton"
                        AutomationProperties.Name="搜索排序"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="搜索结果排序"
                        Visibility="{x:Bind ViewModel.IsSearching, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="&#xE71C;" />
                        <Button.Flyout>
                            <!-- Check mark rides the right-aligned accelerator slot
                                 (KeyboardAcceleratorTextOverride) instead of the
                                 left radio bullet. -->
                            <MenuFlyout Opened="SearchSortFlyout_Opened" Placement="Bottom">
                                <MenuFlyoutItem
                                    x:Name="SortByRelevanceItem"
                                    Click="SearchSortItem_Click"
                                    Tag="0"
                                    Text="按匹配度" />
                                <MenuFlyoutItem
                                    x:Name="SortByNewestItem"
                                    Click="SearchSortItem_Click"
                                    Tag="1"
                                    Text="最新优先" />
                                <MenuFlyoutItem
                                    x:Name="SortByOldestItem"
                                    Click="SearchSortItem_Click"
                                    Tag="2"
                                    Text="最早优先" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <ListView
                    x:Name="NotesList"
                    Grid.Row="2"
                    Padding="8,0,8,8"
                    ItemsSource="{x:Bind ViewModel.Notes, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedNote, Mode=TwoWay}"
                    SelectionChanged="NotesList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NoteItemViewModel">
                            <!-- Row metrics come from the density setting (padding lives
                                 here, not in the container style, so it can bind). -->
                            <Grid
                                Padding="{x:Bind Density, Converter={StaticResource ListDensity}, ConverterParameter=Padding, Mode=OneWay}"
                                PointerEntered="NoteItem_PointerEntered"
                                PointerExited="NoteItem_PointerExited">
                                <StackPanel Spacing="{x:Bind Density, Converter={StaticResource ListDensity}, ConverterParameter=Spacing, Mode=OneWay}">
                                    <TextBlock
                                        controls:TextBlockHighlighter.Keyword="{x:Bind Keyword, Mode=OneWay}"
                                        controls:TextBlockHighlighter.Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                        Margin="0,0,26,0"
                                        FontSize="14"
                                        Style="{StaticResource NoteTitleTextStyle}" />
                                    <TextBlock
                                        controls:TextBlockHighlighter.Keyword="{x:Bind Keyword, Mode=OneWay}"
                                        controls:TextBlockHighlighter.Text="{x:Bind Preview, Mode=OneWay}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind TimeDisplay, Mode=OneWay}" />
                                </StackPanel>
                                <!-- Hover-reveal delete badge (Qt parity: delete lives on the item, not the editor). -->
                                <Button
                                    x:Name="ItemDeleteButton"
                                    Width="24"
                                    Height="24"
                                    Margin="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="删除便签"
                                    Click="ItemDeleteButton_Click"
                                    Style="{StaticResource NoteItemDeleteButtonStyle}"
                                    ToolTipService.ToolTip="删除便签"
                                    Visibility="Collapsed">
                                    <!-- Warm-tinted hover/press states (default Button template
                                         theme resources, per-theme for runtime theme switches). -->
                                    <Button.Resources>
                                        <ResourceDictionary>
                                            <ResourceDictionary.ThemeDictionaries>
                                                <ResourceDictionary x:Key="Light">
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="DangerSubtleFillHoverBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="DangerSubtleFillHoverBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="DangerSubtleBorderHoverBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="DangerSubtleBorderHoverBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="DangerGlyphHoverBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="DangerGlyphHoverBrush" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="Dark">
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="DangerSubtleFillHoverBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="DangerSubtleFillHoverBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="DangerSubtleBorderHoverBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="DangerSubtleBorderHoverBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="DangerGlyphHoverBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="DangerGlyphHoverBrush" />
                                                </ResourceDictionary>
                                                <ResourceDictionary x:Key="HighContrast">
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="DangerSubtleFillHoverBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="DangerSubtleFillHoverBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="DangerSubtleBorderHoverBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="DangerSubtleBorderHoverBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="DangerGlyphHoverBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="DangerGlyphHoverBrush" />
                                                </ResourceDictionary>
                                            </ResourceDictionary.ThemeDictionaries>
                                        </ResourceDictionary>
                                    </Button.Resources>
                                    <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="暂无便签"
                    Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />

                <Border
                    Grid.Row="3"
                    Padding="14,6"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                </Border>
            </Grid>
        </Border>

        <!--  ============ Editor ============  -->
        <Border
            Grid.Column="2"
            Background="{ThemeResource NoteSurfaceBrush}"
            Shadow="{StaticResource PanelShadow}"
            Style="{StaticResource PanelCardStyle}"
            Translation="0,0,28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Empty state  -->
                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}">
                    <FontIcon
                        FontSize="42"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE8A5;" />
                    <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="选择或创建一个便签" />
                </StackPanel>

                <!--  Editor (WinUIRichEditor: a top formatting toolbar + the editor's
                      built-in right-click menu; a bottom status bar carries the dirty
                      flag / char count / last-edited time)  -->
                <Grid
                    Grid.Row="0"
                    Padding="24,20"
                    Visibility="{x:Bind ViewModel.HasSelection, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox
                        x:Name="TitleBox"
                        Grid.Row="0"
                        Padding="0"
                        AutomationProperties.Name="便签标题"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="18"
                        FontWeight="SemiBold"
                        PlaceholderText="无标题便签"
                        Text="{x:Bind ViewModel.EditingTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <!-- Kill default focus visuals in every state: paper surface stays borderless. -->
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>


                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--  Formatting chrome: the vendored WRE toolbar (Normal level — the
                              full text-format set; page/zoom + file actions off, tables
                              off). Trimming is post-stage. The editor's built-in
                              right-click menu (ShowFormattingMenu) replaces the old
                              hand-written ContextFlyout.  -->
                        <wre:RichEditorToolbar
                            x:Name="EditorToolbar"
                            Grid.Row="0"
                            Margin="0,0,0,4"
                            ShowFileActions="False"
                            ShowPageControls="False"
                            Target="{x:Bind Editor}"
                            ToolbarLevel="Normal" />
                        <Grid Grid.Row="1">
                            <!--  The Win2D canvas does NOT follow RequestedTheme by itself
                                  (host responsibility by design): pin the three appearance
                                  brushes through ThemeResource, which re-resolves on a live
                                  Light/Dark switch.  -->
                            <wre:RichEditor
                                x:Name="Editor"
                                AllowDrop="True"
                                AllowFindReplace="True"
                                AllowImages="True"
                                AllowRichPaste="True"
                                AllowTables="False"
                                AutomationProperties.Name="便签内容"
                                CanvasBackground="{ThemeResource NoteSurfaceBrush}"
                                CaretBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                Drop="Editor_Drop"
                                ShowFormattingMenu="True"
                                TextForeground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock
                                x:Name="ContentPlaceholder"
                                Margin="10,10,0,0"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                IsHitTestVisible="False"
                                Text="在这里输入便签内容..." />
                        </Grid>
                    </Grid>

                </Grid>

                <!--  Notepads-style status bar: dirty flag / char count / last edited.
                      Edge-to-edge like the list column's count strip (same divider
                      position, same 6px text insets) so the two bottom rules align.  -->
                <Border
                    Grid.Row="1"
                    Padding="24,6"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{x:Bind ViewModel.HasSelection, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource BrandAccentBrush}"
                            Text="● 未保存"
                            Visibility="{x:Bind ViewModel.IsDirty, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        <TextBlock
                            x:Name="CharCountText"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="0 字" />
                        <TextBlock
                            x:Name="EditedTimeText"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Page-level floating toast for backup/restore final outcomes
             (success=green / failure=red card, auto-dismiss). -->
        <controls:AppToast
            x:Name="ResultTip"
            Grid.ColumnSpan="3"
            Margin="0,2,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top" />
    </Grid>
</Page>
