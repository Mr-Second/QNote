                                </Grid>
                                <!--  重复 row (PRD Decision 10 + 2026-10-15 user rulings: real-To-Do
                                      form — presets carry the QNoteIcons calendar glyphs, 自定义 opens
                                      the 重复周期 dialog, and 从不 moves OUT of the menu onto the
                                      trailing ✕ (To Do's ClearButton). Compact 38px items keep the
                                      6-item menu shorter than the space under the row so
                                      Placement=Bottom cannot flip upward (user: 向上弹出反逻辑).  -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="RepeatRowButton"
                                        Grid.Column="0"
                                        MinHeight="48"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource TodoRowButtonStyle}">
                                        <Button.Flyout>
                                            <!--  Content-sized + tight: no MinWidth, presenter
                                                  padding 4 (default 12 leaves 头尾空白 — user
                                                  2026-10-15), item padding 8, no * spacer column.
                                                  38px items keep the menu short enough to fit
                                                  BELOW the row (Placement=Bottom flips upward
                                                  when taller than the space left).  -->
                                            <Flyout
                                                x:Name="RepeatMenuFlyout"
                                                Placement="Bottom">
                                                <Flyout.FlyoutPresenterStyle>
                                                    <Style TargetType="FlyoutPresenter">
                                                        <Setter Property="Padding" Value="4"/>
                                                    </Style>
                                                </Flyout.FlyoutPresenterStyle>
                                                <!--  MinWidth 200 ≈ 2x the natural content width
                                                      (user: 太窄了，宽度翻倍); item content stays
                                                      LEFT-aligned (Auto columns, no * spacer).  -->
                                                <StackPanel
                                                    MinWidth="200"
                                                    Spacing="2">
                                                    <Button
                                                        MinHeight="38"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Click="RepeatDaily_Click"
                                                        Padding="8,0"
                                                        Style="{StaticResource TodoRowButtonStyle}">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon
                                                                Grid.Column="0"
                                                                FontFamily="{StaticResource QNoteIconsFont}"
                                                                FontSize="15"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Glyph="&#xF52E;"/>
                                                            <TextBlock
                                                                x:Uid="TodoRepeatDaily"
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                FontSize="13"
                                                                Text="每天"/>
                                                        </Grid>
                                                    </Button>
                                                    <Button
                                                        MinHeight="38"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Click="RepeatWeekdays_Click"
                                                        Padding="8,0"
                                                        Style="{StaticResource TodoRowButtonStyle}">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon
                                                                Grid.Column="0"
                                                                FontFamily="{StaticResource QNoteIconsFont}"
                                                                FontSize="15"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Glyph="&#xF530;"/>
                                                            <TextBlock
                                                                x:Uid="TodoRepeatWeekdays"
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                FontSize="13"
                                                                Text="工作日"/>
                                                        </Grid>
                                                    </Button>
                                                    <Button
                                                        MinHeight="38"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Click="RepeatWeekly_Click"
                                                        Padding="8,0"
                                                        Style="{StaticResource TodoRowButtonStyle}">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon
                                                                Grid.Column="0"
                                                                FontFamily="{StaticResource QNoteIconsFont}"
                                                                FontSize="15"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Glyph="&#xF532;"/>
                                                            <TextBlock
                                                                x:Uid="TodoRepeatWeekly"
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                FontSize="13"
                                                                Text="每周"/>
                                                        </Grid>
                                                    </Button>
                                                    <Button
                                                        MinHeight="38"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Click="RepeatMonthly_Click"
                                                        Padding="8,0"
                                                        Style="{StaticResource TodoRowButtonStyle}">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon
                                                                Grid.Column="0"
                                                                FontFamily="{StaticResource QNoteIconsFont}"
                                                                FontSize="15"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Glyph="&#xF52F;"/>
                                                            <TextBlock
                                                                x:Uid="TodoRepeatMonthly"
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                FontSize="13"
                                                                Text="每月"/>
                                                        </Grid>
                                                    </Button>
                                                    <Button
                                                        MinHeight="38"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Click="RepeatYearly_Click"
                                                        Padding="8,0"
                                                        Style="{StaticResource TodoRowButtonStyle}">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon
                                                                Grid.Column="0"
                                                                FontFamily="{StaticResource QNoteIconsFont}"
                                                                FontSize="15"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Glyph="&#xF533;"/>
                                                            <TextBlock
                                                                x:Uid="TodoRepeatYearly"
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                FontSize="13"
                                                                Text="每年"/>
                                                        </Grid>
                                                    </Button>
                                                    <Rectangle
                                                        Height="1"
                                                        Margin="4,3"
                                                        HorizontalAlignment="Stretch"
                                                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                                    <Button
                                                        MinHeight="38"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Click="RepeatCustom_Click"
                                                        Padding="8,0"
                                                        Style="{StaticResource TodoRowButtonStyle}">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon
                                                                Grid.Column="0"
                                                                FontFamily="{StaticResource QNoteIconsFont}"
                                                                FontSize="15"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Glyph="&#xF52D;"/>
                                                            <TextBlock
                                                                x:Uid="TodoRepeatCustom"
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                FontSize="13"
                                                                Text="自定义"/>
                                                        </Grid>
                                                    </Button>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid
                                            MinHeight="28"
                                            ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                Grid.Column="0"
                                                FontSize="15"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE895;"/>
                                            <TextBlock
                                                x:Uid="TodoRepeatLabel"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="13.5"
                                                Text="重复"/>
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource BrandAccentBrush}"
                                                Text="{x:Bind conv:TodoText.RecurrenceText(ViewModel.DetailRecurrenceRule), Mode=OneWay}"
                                                TextAlignment="Right"
                                                TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Button>
                                    <!--  Trailing ✕: clear the rule (value state only) — To Do's
                                          ClearButton「从不重复」; 从不 is NOT a menu item.  -->
                                    <Button
                                        x:Uid="TodoRecurrenceClearButton"
                                        Grid.Column="1"
                                        Width="44"
                                        MinHeight="48"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Click="RepeatClear_Click"
                                        Style="{StaticResource TodoIconButtonStyle}"
                                        Visibility="{x:Bind ViewModel.DetailHasRecurrence, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                        <FontIcon
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE711;"/>
                                    </Button>
                                </Grid>
                                <!--  添加文件 row (PRD Decision 11): click = file picker;                      attachments list under the row.  -->
                                <Button
                                    x:Name="AttachRowButton"
                                    MinHeight="48"
                                    HorizontalAlignment="Stretch"
                                    Click="AttachRow_Click"
                                    Style="{StaticResource TodoRowButtonStyle}">
                                    <Grid
                                        MinHeight="28"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Grid.Column="0"
                                            FontSize="15"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE723;"/>
                                        <TextBlock
                                            x:Uid="TodoAttachLabel"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="13.5"
                                            Text="添加文件"/>
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="12.5"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource BrandAccentBrush}"
                                            Text="{x:Bind conv:TodoText.AttachmentCountText(ViewModel.DetailAttachments.Count), Mode=OneWay}"
                                            TextAlignment="Right"
                                            TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Button>
                                <!--  Attachments list (newest first, mirrors VM collection).  -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.DetailAttachments, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:TodoAttachment">
                                            <Grid Margin="10,2,4,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!--  Type indicator (NOT clickable — the filename
                                                      button is the open affordance; see 10-15 user
                                                      ruling against the duplicated open button).  -->
                                                <Grid
                                                    Grid.Column="0"
                                                    Width="28"
                                                    Height="32">
                                                    <FontIcon
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="{x:Bind conv:TodoText.AttachmentGlyph(FileName), Mode=OneTime}"/>
                                                </Grid>
                                                <Button
                                                    Grid.Column="1"
                                                    Margin="2,0,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Click="AttachmentOpen_Click"
                                                    Style="{StaticResource TodoRowButtonStyle}"
                                                    Tag="{x:Bind}">
                                                    <TextBlock
                                                        FontSize="12.5"
                                                        Text="{x:Bind FileName}"
                                                        TextTrimming="CharacterEllipsis"/>
                                                </Button>
                                                <Button
                                                    x:Uid="TodoAttachmentDeleteButton"
                                                    Grid.Column="2"
                                                    Width="28"
                                                    Height="32"
                                                    Padding="0"
                                                    Click="AttachmentDelete_Click"
                                                    Style="{StaticResource TodoIconButtonStyle}"
                                                    Tag="{x:Bind}">
                                                    <FontIcon
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xE711;"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <!--  Notes  -->
                        <Border
                            Style="{StaticResource TodoCardStyle}"
                            Padding="14,12">
                            <TextBox
                                x:Name="DetailNotesBox"
                                x:Uid="TodoNotesBox"
                                MinHeight="110"
                                AcceptsReturn="True"
                                PlaceholderText="添加备注"
                                Text="{x:Bind ViewModel.DetailNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap">
                                <TextBox.Resources>
                                    <ResourceDictionary>
                                        <SolidColorBrush
                                            x:Key="TextControlBackground"
                                            Color="Transparent"/>
                                        <SolidColorBrush
                                            x:Key="TextControlBackgroundPointerOver"
                                            Color="Transparent"/>
                                        <SolidColorBrush
                                            x:Key="TextControlBackgroundFocused"
                                            Color="Transparent"/>
                                        <SolidColorBrush
                                            x:Key="TextControlBackgroundDisabled"
                                            Color="Transparent"/>
                                        <SolidColorBrush
                                            x:Key="TextControlBorderBrush"
                                            Color="Transparent"/>
                                        <SolidColorBrush
                                            x:Key="TextControlBorderBrushPointerOver"
                                            Color="Transparent"/>
                                        <SolidColorBrush
                                            x:Key="TextControlBorderBrushFocused"
                                            Color="Transparent"/>
                                        <SolidColorBrush
                                            x:Key="TextControlBorderBrushDisabled"
                                            Color="Transparent"/>
                                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">
                                            0
                                        </Thickness>
                                    </ResourceDictionary>
                                </TextBox.Resources>
                            </TextBox>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!--  Footer (real To Do three-segment form): centered 创建于 +                      right 删除任务 (staged delete + undo toast). No save/cancel —                      the 800 ms debounce is the only save channel.  -->
                <Border
                    Grid.Row="2"
                    Padding="12,6,12,8"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind conv:TodoText.CreatedAtText(ViewModel.DetailCreatedAt), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"/>
                        <Button
                            x:Uid="TodoDetailDeleteButton"
                            Grid.Column="1"
                            Width="44"
                            Height="40"
                            Padding="0"
                            Command="{x:Bind ViewModel.DeleteTaskCommand}"
                            CommandParameter="{x:Bind ViewModel.SelectedTask, Mode=OneWay}"
                            Style="{StaticResource TodoIconButtonStyle}">
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE74D;"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <!--  Detail pane splitter (8px, resize cursor; collapses with the pane)  -->
        <local:PaneSplitter
            x:Name="DetailSplitter"
            Grid.Column="3"
            DragCompleted="PaneSplitter_DragCompleted"
            DragDelta="DetailSplitter_DragDelta"
            Style="{StaticResource PaneSplitterStyle}"
            Visibility="{x:Bind ViewModel.HasSelectedTask, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"/>
        <!--  Page-level floating toast (delete-undo / list errors / settings              outcomes — same control as NotesPage).  -->
        <controls:AppToast
            x:Name="ResultTip"
            Grid.ColumnSpan="5"
            Margin="0,2,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"/>
    </Grid>
</Page>
