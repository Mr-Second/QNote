<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="QNote.Views.TodoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:QNote.Controls"
    xmlns:conv="using:QNote.Converters"
    xmlns:models="using:QNote.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:QNote.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:QNote.ViewModels"
    KeyDown="Page_KeyDown"
    mc:Ignorable="d">
    <Page.Resources>
        <ThemeShadow x:Key="PanelShadow" />
        <!--  Icon fonts (mstodo parity): the alarm clock is Fabric MDL2's        E919 (MIT, fluentui/font-icons-mdl2 subset — To Do's own glyph        family; Segoe fonts have NO twin-bell alarm clock). The calendar must        pin Segoe MDL2 Assets: the Win11 default (SegoeIcons) remapped E787        to a CALCULATOR.  -->
        <FontFamily x:Key="FabricMdl2Font">ms-appx:///Assets/Fonts/FabricMDL2Icons.ttf#Fabric MDL2 Assets</FontFamily>
        <FontFamily x:Key="QNoteIconsFont">ms-appx:///Assets/Fonts/QNoteIcons.ttf#QNoteIcons</FontFamily>
        <FontFamily x:Key="Mdl2Font">Segoe MDL2 Assets</FontFamily>
        <!--  Flat task card (a4: white card, hairline stroke, no per-card shadow —              N shadows on a list costs more than it reads; the mockup's lift comes              from the canvas contrast).  -->
        <Style
            x:Key="TodoCardStyle"
            TargetType="Border">
            <Setter
                Property="Background"
                Value="{ThemeResource LayerFillColorDefaultBrush}"/>
            <Setter
                Property="BorderBrush"
                Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter
                Property="BorderThickness"
                Value="1"/>
            <Setter
                Property="CornerRadius"
                Value="8"/>
        </Style>
        <!--  Task ROW: opaque card on the gradient pane (real To Do floats white
              rows on the list background — user 2026-10-15; the earlier flat
              transparent row let the gradient wash out the hairline). Bottom
              hairline separator, 4px corner; hover/selection fill comes from the
              ListViewItem presenter.  -->
        <Style
            x:Key="TodoRowStyle"
            TargetType="Border">
            <Setter
                Property="Background"
                Value="{ThemeResource TodoRowBackgroundBrush}"/>
            <Setter
                Property="BorderBrush"
                Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter
                Property="BorderThickness"
                Value="0,0,0,1"/>
            <Setter
                Property="CornerRadius"
                Value="4"/>
        </Style>
        <!--  已完成 accordion chip (user 2026-10-15: a SHORT content-sized segment
              trailing the last task — real To Do floats it inside the list flow,
              NOT a full-width bar; at rest translucent, hover opaque, and the
              checked state must NOT flip to the accent-blue ToggleButton default
              — hence the custom template with inert CheckStates).  -->
        <Style
            x:Key="TodoCompletedToggleStyle"
            TargetType="ToggleButton">
            <Setter
                Property="Padding"
                Value="10,6"/>
            <Setter
                Property="Background"
                Value="{ThemeResource TodoCompletedHeaderBrush}"/>
            <Setter
                Property="CornerRadius"
                Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="HoverLayer.Background"
                                                Value="{ThemeResource TodoRowBackgroundBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="HoverLayer.Background"
                                                Value="{ThemeResource TodoRowBackgroundBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="ContentPresenter.Opacity"
                                                Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <!--  Inert: the chip looks the same checked or not
                                      (the chevron rotation carries the state).  -->
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked" />
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="HoverLayer"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"/>
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  Pane splitter (mstodo-ui-extraction: 8px, invisible until hover,              resize cursor — see Views/PaneSplitter.cs; drag handlers in the              code-behind resize the named column definitions; clamps: nav 240..420,              detail 300..520).  -->
        <Style
            x:Key="PaneSplitterStyle"
            TargetType="local:PaneSplitter">
            <Setter
                Property="Width"
                Value="8"/>
            <Setter
                Property="VerticalAlignment"
                Value="Stretch"/>
            <Setter
                Property="Background"
                Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:PaneSplitter">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="HitLayer.Background"
                                                Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="HitLayer.Background"
                                                Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="HitLayer"
                                Background="Transparent"
                                CornerRadius="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  Chrome-less icon button: transparent in every state, subtle fill on              hover/press. Hosts the circle checkbox, the star and the ✕ targets so              their clicks stay independent of the row selection.  -->
        <Style
            x:Key="TodoIconButtonStyle"
            TargetType="Button">
            <Setter
                Property="MinWidth"
                Value="0"/>
            <Setter
                Property="MinHeight"
                Value="0"/>
            <Setter
                Property="Padding"
                Value="4"/>
            <Setter
                Property="Background"
                Value="Transparent"/>
            <Setter
                Property="BorderThickness"
                Value="0"/>
            <Setter
                Property="CornerRadius"
                Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="HoverLayer.Background"
                                                Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="HoverLayer.Background"
                                                Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="ContentPresenter.Opacity"
                                                Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="HoverLayer"
                                Background="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}"/>
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  Hero ⋯ button (user 2026-10-16): rides the colorful pane gradient
              like the hero title — the subtle-gray hover of TodoIconButtonStyle
              is invisible on the dark gradient, so this variant paints WHITE
              translucent hover/press layers instead (readable over every theme
              color/image in both Light and Dark).  -->
        <Style
            x:Key="TodoHeroIconButtonStyle"
            TargetType="Button">
            <Setter
                Property="MinWidth"
                Value="0"/>
            <Setter
                Property="MinHeight"
                Value="0"/>
            <Setter
                Property="Padding"
                Value="4"/>
            <Setter
                Property="Background"
                Value="Transparent"/>
            <Setter
                Property="BorderThickness"
                Value="0"/>
            <Setter
                Property="CornerRadius"
                Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="HoverLayer.Background"
                                                Value="#26FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="HoverLayer.Background"
                                                Value="#3FFFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="ContentPresenter.Opacity"
                                                Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="HoverLayer"
                                Background="Transparent"
                                CornerRadius="{TemplateBinding CornerRadius}"/>
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  Stretchy transparent row button (nav rows + detail action rows):              the row content rides the ContentPresenter, hover gets a subtle fill.  -->
        <Style
            x:Key="TodoRowButtonStyle"
            TargetType="Button">
            <Setter
                Property="MinWidth"
                Value="0"/>
            <Setter
                Property="MinHeight"
                Value="36"/>
            <Setter
                Property="Padding"
                Value="10,8"/>
            <Setter
                Property="HorizontalAlignment"
                Value="Stretch"/>
            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch"/>
            <Setter
                Property="Background"
                Value="Transparent"/>
            <Setter
                Property="BorderThickness"
                Value="0"/>
            <Setter
                Property="CornerRadius"
                Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="HoverLayer.Background"
                                                Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="HoverLayer.Background"
                                                Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter
                                                Target="ContentPresenter.Opacity"
                                                Value="0.4"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border
                                x:Name="HoverLayer"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"/>
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  ============ Nav templates (left pane) ============  -->
        <local:TodoNavTemplateSelector x:Key="NavTemplateSelector">
            <local:TodoNavTemplateSelector.SmartTemplate>
                <DataTemplate x:DataType="vm:TodoNavItemViewModel">
                    <Button
                        Padding="10,10"
                        Background="{x:Bind conv:TodoText.NavRowBackground(IsSelected), Mode=OneWay}"
                        Click="NavRow_Click"
                        Style="{StaticResource TodoRowButtonStyle}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Grid.Column="0"
                                Width="16"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Mdl2Font}"
                                FontSize="14"
                                Foreground="{x:Bind conv:TodoText.NavIconBrush(IsSelected), Mode=OneWay}"
                                Glyph="{x:Bind IconGlyph, Mode=OneWay}"/>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{x:Bind conv:TodoText.NavTitleBrush(IsSelected), Mode=OneWay}"
                                Text="{x:Bind conv:TodoText.NavTitleText(TitleKey, Title), Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind CountText, Mode=OneWay}"/>
                        </Grid>
                    </Button>
                </DataTemplate>
            </local:TodoNavTemplateSelector.SmartTemplate>
            <local:TodoNavTemplateSelector.CapTemplate>
                <DataTemplate x:DataType="vm:TodoNavItemViewModel">
                    <TextBlock
                        Margin="14,10,0,4"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind conv:TodoText.ResKeyText(TitleKey), Mode=OneWay}"/>
                </DataTemplate>
            </local:TodoNavTemplateSelector.CapTemplate>
            <local:TodoNavTemplateSelector.ListTemplate>
                <DataTemplate x:DataType="vm:TodoNavItemViewModel">
                    <Button
                        Padding="10,10"
                        Background="{x:Bind conv:TodoText.NavRowBackground(IsSelected), Mode=OneWay}"
                        Click="NavRow_Click"
                        Style="{StaticResource TodoRowButtonStyle}">
                        <Button.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    x:Uid="TodoRenameList"
                                    Click="RenameListMenu_Click"
                                    Tag="{x:Bind}"
                                    Text="重命名">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon
                                            FontSize="12"
                                            Glyph="&#xE70F;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Uid="TodoDeleteList"
                                    Click="DeleteListMenu_Click"
                                    Tag="{x:Bind}"
                                    Text="删除">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon
                                            FontSize="12"
                                            Glyph="&#xE74D;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.ContextFlyout>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse
                                Grid.Column="0"
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{x:Bind ColorHex, Converter={StaticResource HexToBrush}, Mode=OneWay}"/>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{x:Bind conv:TodoText.NavTitleBrush(IsSelected), Mode=OneWay}"
                                Text="{x:Bind conv:TodoText.NavTitleText(TitleKey, Title), Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind CountText, Mode=OneWay}"/>
                        </Grid>
                    </Button>
                </DataTemplate>
            </local:TodoNavTemplateSelector.ListTemplate>
        </local:TodoNavTemplateSelector>
        <!--  ============ Task row templates (middle pane) ============  -->
        <!--  mstodo-ui-extraction #1/#2: flat hairline row (56px, 2-line 68), due              date BELOW the title as a second metadata line, star alone at the right              edge vertically centered.  -->
        <local:TodoTaskTemplateSelector x:Key="TaskTemplateSelector">
            <local:TodoTaskTemplateSelector.IncompleteTemplate>
                <DataTemplate x:DataType="vm:TodoTaskItemViewModel">
                    <Border MinHeight="55" Style="{StaticResource TodoRowStyle}">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    x:Uid="TodoTaskDelete"
                                    Click="TaskDeleteMenu_Click"
                                    Tag="{x:Bind}"
                                    Text="删除">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon
                                            FontSize="12"
                                            Glyph="&#xE74D;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Border.ContextFlyout>
                        <Grid
                            Padding="12,8"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--  Circle checkbox (independent target; a4 form)  -->
                            <Button
                                x:Uid="TodoTaskCheckButton"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Click="TaskCheck_Click"
                                Style="{StaticResource TodoIconButtonStyle}">
                                <Grid
                                    Width="20"
                                    Height="20">
                                    <Ellipse
                                        Width="18"
                                        Height="18"
                                        Fill="{x:Bind conv:TodoText.CheckFillBrush(IsCompleted), Mode=OneWay}"
                                        Stroke="{x:Bind conv:TodoText.CheckStrokeBrush(IsCompleted), Mode=OneWay}"
                                        StrokeThickness="1.5"/>
                                    <FontIcon
                                        FontSize="10"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Glyph="&#xE73E;"
                                        Opacity="{x:Bind conv:TodoText.CheckIconOpacity(IsCompleted), Mode=OneWay}"/>
                                </Grid>
                            </Button>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    MaxLines="2"
                                    Style="{StaticResource NoteTitleTextStyle}"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"/>
                                <!--  Metadata line: due + repeat + steps in ONE inline run (real To
                                      Do rows never stack them — user 2026-10-15: the repeat icon
                                      rides right behind the due text with a small margin).  -->
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="5"
                                    Visibility="{x:Bind conv:TodoText.MetaLineVisibility(HasDue, HasRecurrence, HasSteps), Mode=OneWay}">
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{x:Bind conv:TodoText.DueBrush(IsOverdue, IsCompleted), Mode=OneWay}"
                                        Glyph="&#xE823;"
                                        Opacity="0.8"
                                        Visibility="{x:Bind HasDue, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"/>
                                    <TextBlock
                                        FontSize="11.5"
                                        Foreground="{x:Bind conv:TodoText.DueBrush(IsOverdue, IsCompleted), Mode=OneWay}"
                                        Text="{x:Bind conv:TodoText.DueText(DueAt, IsAllDay), Mode=OneWay}"
                                        Visibility="{x:Bind HasDue, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"/>
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE895;"
                                        Visibility="{x:Bind HasRecurrence, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"/>
                                    <TextBlock
                                        FontSize="11.5"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind conv:TodoText.StepsText(StepsDone, StepsTotal), Mode=OneWay}"
                                        Visibility="{x:Bind HasSteps, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"/>
                                </StackPanel>
                            </StackPanel>
                            <!--  Star: alone at the right edge, vertically centered  -->
                            <Button
                                x:Uid="TodoTaskStarButton"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="TaskStar_Click"
                                Style="{StaticResource TodoIconButtonStyle}">
                                <FontIcon
                                    FontSize="14"
                                    Glyph="{x:Bind conv:TodoText.StarGlyph(IsImportant), Mode=OneWay}"
                                    Foreground="{x:Bind conv:TodoText.StarBrush(IsImportant), Mode=OneWay}"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </local:TodoTaskTemplateSelector.IncompleteTemplate>
            <local:TodoTaskTemplateSelector.CompletedTemplate>
                <DataTemplate x:DataType="vm:TodoTaskItemViewModel">
                    <Border MinHeight="55" Style="{StaticResource TodoRowStyle}">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    x:Uid="TodoTaskDelete"
                                    Click="TaskDeleteMenu_Click"
                                    Tag="{x:Bind}"
                                    Text="删除">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon
                                            FontSize="12"
                                            Glyph="&#xE74D;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Border.ContextFlyout>
                        <Grid>
                        <!--  Full-row body (user 2026-10-16): the hover + click-to-detail
                              target spans the WHOLE row — the old col-1-only button
                              carried Padding=0 (the 10-15 height fix), so its hover
                              band hugged the text's left/bottom edges. The text keeps
                              its old 44px inset (= 12 grid + 20 check + 12 gap),
                              matching the incomplete rows.  -->
                        <Button
                            Padding="44,8"
                            HorizontalContentAlignment="Left"
                            VerticalAlignment="Stretch"
                            Click="CompletedTask_Click"
                            Style="{StaticResource TodoRowButtonStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource NoteTitleTextStyle}"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    TextDecorations="Strikethrough"
                                    TextTrimming="CharacterEllipsis"/>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="5"
                                    Visibility="{x:Bind HasDue, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{x:Bind conv:TodoText.DueBrush(IsOverdue, IsCompleted), Mode=OneWay}"
                                        Glyph="&#xE823;"
                                        Opacity="0.8"/>
                                    <TextBlock
                                        FontSize="11.5"
                                        Foreground="{x:Bind conv:TodoText.DueBrush(IsOverdue, IsCompleted), Mode=OneWay}"
                                        Text="{x:Bind conv:TodoText.DueText(DueAt, IsAllDay), Mode=OneWay}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <!--  Check circle + star as OVERLAY siblings above the body
                              button (tail list has no selection): the overlay Grid is
                              hit-test-transparent where empty, so clicks between the
                              icons fall through to the body button (same overlay
                              pattern as the detail property rows).  -->
                        <Grid
                            Padding="12,8"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Uid="TodoTaskUncheckButton"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Click="TaskCheck_Click"
                                Style="{StaticResource TodoIconButtonStyle}">
                                <Grid
                                    Width="20"
                                    Height="20">
                                    <Ellipse
                                        Width="18"
                                        Height="18"
                                        Fill="{x:Bind conv:TodoText.CheckFillBrush(IsCompleted), Mode=OneWay}"
                                        Stroke="{x:Bind conv:TodoText.CheckStrokeBrush(IsCompleted), Mode=OneWay}"
                                        StrokeThickness="1.5"/>
                                    <FontIcon
                                        FontSize="10"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Glyph="&#xE73E;"
                                        Opacity="{x:Bind conv:TodoText.CheckIconOpacity(IsCompleted), Mode=OneWay}"/>
                                </Grid>
                            </Button>
                            <Button
                                x:Uid="TodoTaskStarButton"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="TaskStar_Click"
                                Style="{StaticResource TodoIconButtonStyle}">
                                <FontIcon
                                    FontSize="14"
                                    Glyph="{x:Bind conv:TodoText.StarGlyph(IsImportant), Mode=OneWay}"
                                    Foreground="{x:Bind conv:TodoText.StarBrush(IsImportant), Mode=OneWay}"/>
                            </Button>
                        </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </local:TodoTaskTemplateSelector.CompletedTemplate>
        </local:TodoTaskTemplateSelector>
        <!--  Borderless TextBox treatment (NotesPage TitleBox pattern).  -->
    </Page.Resources>
    <Grid
        x:Name="RootGrid"
        Margin="12">
        <Grid.ColumnDefinitions>
            <!--  mstodo-ui-extraction §1/§5.5: fixed side panes (280 nav / 360              detail) + 8px draggable Thumb splitters; only the middle list flexes.  -->
            <ColumnDefinition
                x:Name="NavColumn"
                Width="280"/>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition
                Width="*"
                MinWidth="320"/>
            <ColumnDefinition Width="Auto" />
            <!--  Detail column: starts COLLAPSED (0) — the pane hides by zeroing                      its column; the show-time clamp sets the fitting width (never                      overflows the layout at any window size).  -->
            <ColumnDefinition
                x:Name="DetailColumn"
                Width="0"/>
        </Grid.ColumnDefinitions>
        <!--  ============ Left pane (280px) ============  -->
        <Border
            Grid.Column="0"
            Style="{StaticResource PanelCardStyle}"
            Shadow="{StaticResource PanelShadow}"
            Translation="0,0,12">
            <Grid
                Padding="10"
                RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!--  便签/待办 segmented switch (same control as NotesPage's sidebar)  -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <SelectorBar x:Name="ModeSelector" Grid.Column="0" Margin="2,0"
                                 SelectionChanged="ModeSelector_SelectionChanged">
                        <SelectorBarItem x:Name="NotesModeItem" x:Uid="ModeNotesItem" Text="便签" />
                        <SelectorBarItem x:Name="TodoModeItem" x:Uid="ModeTodoItem" IsSelected="True" Text="待办" />
                    </SelectorBar>
                    <Button x:Name="TodoSyncNowButton" x:Uid="SyncNowButton" Grid.Column="1"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="TodoSyncNowButton"
                            Style="{StaticResource NoteHeaderActionButtonStyle}"
                            IsEnabled="False" Click="TodoSyncNow_Click" ToolTipService.ToolTip="立即同步">
                        <FontIcon FontSize="16" Glyph="&#xE72C;">
                            <FontIcon.RenderTransform>
                                <RotateTransform x:Name="TodoSyncNowRotate" Angle="0" CenterX="8" CenterY="8" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                </Grid>
                <!--  Search (debounced in the VM; filters tasks by title)  -->
                <AutoSuggestBox
                    x:Uid="TodoSearch"
                    AutomationProperties.AutomationId="TodoSearch"
                    Grid.Row="1"
                    Padding="10,6"
                    PlaceholderText="搜索任务"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <!--  智能视图 + 我的清单 (flat collection, template-selected)  -->
                <ListView
                    x:Name="NavList"
                    Grid.Row="2"
                    ItemTemplateSelector="{StaticResource NavTemplateSelector}"
                    ItemsSource="{x:Bind ViewModel.NavItems, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter
                                Property="MinHeight"
                                Value="0"/>
                            <Setter
                                Property="Margin"
                                Value="0,1"/>
                            <Setter
                                Property="Padding"
                                Value="0"/>
                            <Setter
                                Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <!--  Bottom bar: 新建清单 + settings (same settings surface as NotesPage)  -->
                <Grid
                    Grid.Row="3"
                    ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Uid="TodoNewListButton"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="NewListButton_Click"
                        Style="{StaticResource TodoRowButtonStyle}"
                        ToolTipService.ToolTip="新建清单">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon
                                FontSize="13"
                                Glyph="&#xE710;"/>
                            <TextBlock
                                x:Uid="TodoNewList"
                                FontSize="12.5"
                                Text="新建清单"/>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Uid="SettingsButton"
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="SettingsButton_Click"
                        Style="{StaticResource TodoIconButtonStyle}"
                        ToolTipService.ToolTip="设置">
                        <FontIcon
                            FontSize="14"
                            Glyph="&#xE713;"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>
        <!--  Nav pane splitter (8px, resize cursor)  -->
        <local:PaneSplitter
            x:Name="NavSplitter"
            Grid.Column="1"
            DragCompleted="PaneSplitter_DragCompleted"
            DragDelta="NavSplitter_DragDelta"
            Style="{StaticResource PaneSplitterStyle}"/>
        <!--  ============ Middle pane ============  -->
        <Border
            Grid.Column="2"
            Background="{ThemeResource TodoPaneBackgroundBrush}"
            Style="{StaticResource PanelCardStyle}"
            Shadow="{StaticResource PanelShadow}"
            Translation="0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!--  Per-view 主题 overlay (list-options menu, user 2026-10-16):
                      paints the pane background for non-default themes; the pane
                      keeps its ThemeResource gradient underneath (id 0 = no
                      overlay). High Contrast never themes over its window color.  -->
                <Border
                    x:Name="PaneThemeOverlay"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    CornerRadius="7"
                    IsHitTestVisible="False"
                    Background="{x:Bind conv:TodoTheme.PaneOverlayBrush(ViewModel.ActiveThemeId), Mode=OneWay}"
                    Visibility="{x:Bind conv:TodoTheme.PaneOverlayVisibility(ViewModel.ActiveThemeId, ViewModel.IsHighContrast), Mode=OneWay}"/>
                <!--  Hero: title/date in white riding the PANE-WIDE gradient (user
                      2026-10-15: the gradient is the whole B-area background; the
                      hero band paints its own fill only in HighContrast).  -->
                <Border
                    Grid.Row="0"
                    Margin="1,1,1,0"
                    Background="{ThemeResource TodoHeroBackgroundBrush}"
                    CornerRadius="7,7,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Grid.Column="0"
                            Margin="26,22,0,18">
                            <StackPanel Spacing="3">
                                <TextBlock
                                    FontSize="30"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource TodoHeroForegroundBrush}"
                                    Text="{x:Bind conv:TodoText.NavTitleText(ViewModel.HeroTitleKey, ViewModel.HeroTitleRaw), Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"/>
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{ThemeResource TodoHeroForegroundBrush}"
                                    Opacity="0.92"
                                    Text="{x:Bind conv:TodoText.HeroDate(ViewModel.IsTodayView), Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                        <!--  列表选项 ⋯ (real-To-Do parity, user 2026-10-16): theme
                              grid + 排序依据 / 隐藏已完成 / 打印 / 邮件 / 固定 /
                              隐藏智能清单. Icon = QNoteIcons TodoToolsDots F534.  -->
                        <Button
                            x:Uid="TodoListOptionsButton"
                            Grid.Column="1"
                            Width="36"
                            Height="36"
                            Margin="0,14,14,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource TodoHeroIconButtonStyle}">
                            <Button.Flyout>
                                <Flyout
                                    x:Name="ListOptionsFlyout"
                                    ShouldConstrainToRootBounds="False"
                                    Placement="Bottom"
                                    Opening="ListOptionsFlyout_Opening">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="4"/>
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel
                                        MinWidth="232"
                                        Spacing="2">
                                        <!--  排序依据 (real-To-Do row form): opens the
                                              mode flyout to the right.  -->
                                        <Grid>
                                            <Button
                                                x:Name="SortRowButton"
                                                MinHeight="40"
                                                Padding="8,0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Click="SortRow_Click"
                                                Style="{StaticResource TodoRowButtonStyle}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon
                                                        Grid.Column="0"
                                                        FontFamily="{StaticResource QNoteIconsFont}"
                                                        FontSize="15"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="&#xF53A;"/>
                                                    <TextBlock
                                                        x:Uid="TodoSortBy"
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        Text="排序依据"/>
                                                    <FontIcon
                                                        Grid.Column="2"
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Glyph="&#xE76C;"/>
                                                </Grid>
                                            </Button>
                                            <FlyoutBase.AttachedFlyout>
                                                <Flyout
                                                    x:Name="SortFlyout"
                                                    ShouldConstrainToRootBounds="False"
                                                    Placement="Right"
                                                    Opening="SortFlyout_Opening">
                                                    <Flyout.FlyoutPresenterStyle>
                                                        <Style TargetType="FlyoutPresenter">
                                                            <Setter Property="Padding" Value="4"/>
                                                        </Style>
                                                    </Flyout.FlyoutPresenterStyle>
                                                    <StackPanel
                                                        x:Name="SortFlyoutPanel"
                                                        MinWidth="160"
                                                        Spacing="2"/>
                                                </Flyout>
                                            </FlyoutBase.AttachedFlyout>
                                        </Grid>
                                        <!--  主题 swatch grid — cells built in code-behind
                                              (TodoTheme.Options + the default-gradient
                                              cell). Real-To-Do form (user 2026-10-16).  -->
                                        <StackPanel
                                            Margin="4,6,4,2"
                                            Spacing="6">
                                            <TextBlock
                                                x:Uid="TodoThemeLabel"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="主题"/>
                                            <Grid x:Name="ThemeSwatchGrid"/>
                                        </StackPanel>
                                        <Rectangle
                                            Height="1"
                                            Margin="4,3"
                                            HorizontalAlignment="Stretch"
                                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                        <!--  隐藏已完成的任务 (toggle row, trailing check).  -->
                                        <Button
                                            x:Uid="TodoHideCompletedRow"
                                            MinHeight="40"
                                            Padding="8,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Click="HideCompletedRow_Click"
                                            Style="{StaticResource TodoRowButtonStyle}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    Grid.Column="0"
                                                    FontFamily="{StaticResource QNoteIconsFont}"
                                                    FontSize="15"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xF537;"/>
                                                <TextBlock
                                                    x:Uid="TodoHideCompletedLabel"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Text="隐藏已完成任务"/>
                                                <FontIcon
                                                    Grid.Column="2"
                                                    FontSize="13"
                                                    Foreground="{ThemeResource BrandAccentBrush}"
                                                    Glyph="&#xE73E;"
                                                    Visibility="{x:Bind ViewModel.ActiveHideCompleted, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"/>
                                            </Grid>
                                        </Button>
                                        <!--  以电子邮件发送列表  -->
                                        <Button
                                            MinHeight="40"
                                            Padding="8,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Click="EmailList_Click"
                                            Style="{StaticResource TodoRowButtonStyle}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    Grid.Column="0"
                                                    FontFamily="{StaticResource QNoteIconsFont}"
                                                    FontSize="15"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xF535;"/>
                                                <TextBlock
                                                    x:Uid="TodoEmailListLabel"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Text="以电子邮件发送列表"/>
                                            </Grid>
                                        </Button>
                                        <!--  固定到"开始"  -->
                                        <Button
                                            MinHeight="40"
                                            Padding="8,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Click="PinList_Click"
                                            Style="{StaticResource TodoRowButtonStyle}"
                                            Visibility="{x:Bind conv:TodoText.ListOnlyVisibility(ViewModel.SelectedNav.Kind), Mode=OneWay}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    Grid.Column="0"
                                                    FontFamily="{StaticResource QNoteIconsFont}"
                                                    FontSize="15"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xF538;"/>
                                                <TextBlock
                                                    x:Uid="TodoPinListLabel"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Text="固定到开始"/>
                                            </Grid>
                                        </Button>
                                        <!--  隐藏智能列表 (smart views only; 全部 is the
                                              fallback anchor and never hideable).  -->
                                        <Button
                                            MinHeight="40"
                                            Padding="8,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Click="HideSmartList_Click"
                                            Style="{StaticResource TodoRowButtonStyle}"
                                            Visibility="{x:Bind ViewModel.CanHideCurrentSmartList, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    Grid.Column="0"
                                                    FontFamily="{StaticResource QNoteIconsFont}"
                                                    FontSize="15"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xF536;"/>
                                                <TextBlock
                                                    x:Uid="TodoHideSmartListLabel"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Text="隐藏智能列表"/>
                                            </Grid>
                                        </Button>
                                        <!--  显示智能列表 (user 2026-10-16): the RESTORE
                                              counterpart on 全部 — the fallback view is the
                                              natural home for it; appears only while
                                              something IS hidden.  -->
                                        <Button
                                            MinHeight="40"
                                            Padding="8,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Click="RestoreSmartLists_Click"
                                            Style="{StaticResource TodoRowButtonStyle}"
                                            Visibility="{x:Bind conv:TodoText.ShowSmartListRowVisibility(ViewModel.SelectedNav.Kind, ViewModel.HiddenSmartKinds.Count), Mode=OneWay}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    Grid.Column="0"
                                                    FontFamily="{StaticResource Mdl2Font}"
                                                    FontSize="15"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="&#xE7B3;"/>
                                                <TextBlock
                                                    x:Uid="TodoShowSmartListLabel"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Text="显示智能列表"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <FontIcon
                                FontFamily="{StaticResource QNoteIconsFont}"
                                FontSize="15"
                                Foreground="{ThemeResource TodoHeroForegroundBrush}"
                                Glyph="&#xF534;"/>
                        </Button>
                    </Grid>
                </Border>
                <!--  Task cards: FLAT (no group headers). Real-To-Do completed
                      section (user 2026-10-15): the chip + tail list trail the
                      LAST incomplete task, not the viewport bottom — an outer
                      ScrollViewer hosts [ListView (inner scrolling disabled, so
                      it auto-sizes to its items) → chip → completed list];
                      ListView.Footer instead stretches to the pane bottom on
                      short lists. Trade-off: no list virtualization — fine at
                      personal list scale.  -->
                <Grid Grid.Row="1">
                    <ScrollViewer
                        Padding="14,10,0,6">
                        <StackPanel
                            Margin="0,0,14,0">
                            <ListView
                                x:Name="TaskList"
                                ItemTemplateSelector="{StaticResource TaskTemplateSelector}"
                                ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}"
                                KeyDown="TaskList_KeyDown"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                SelectedItem="{x:Bind ViewModel.SelectedTask, Mode=OneWay}"
                                SelectionChanged="TaskList_SelectionChanged"
                                SelectionMode="Single">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter
                                            Property="Margin"
                                            Value="0,2"/>
                                        <Setter
                                            Property="Padding"
                                            Value="0"/>
                                        <Setter
                                            Property="MinHeight"
                                            Value="0"/>
                                        <Setter
                                            Property="CornerRadius"
                                            Value="4"/>
                                        <Setter
                                            Property="HorizontalContentAlignment"
                                            Value="Stretch"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                            <!--  Spacing ruling (user 2026-10-15): 10px from the
                                  last incomplete row to the chip, 8px chip →
                                  first completed row.  -->
                            <ToggleButton
                                x:Uid="TodoCompletedSection"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                IsChecked="{x:Bind ViewModel.IsCompletedExpanded, Mode=TwoWay}"
                                Style="{StaticResource TodoCompletedToggleStyle}"
                                Visibility="{x:Bind ViewModel.ShowCompletedToggle, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <FontIcon
                                        x:Name="CompletedChevron"
                                        FontSize="12"
                                        Glyph="&#xE70D;"
                                        RenderTransformOrigin="0.5,0.5">
                                        <FontIcon.RenderTransform>
                                            <RotateTransform Angle="{x:Bind conv:TodoText.ChevronRotation(ViewModel.IsCompletedExpanded), Mode=OneWay}"/>
                                        </FontIcon.RenderTransform>
                                    </FontIcon>
                                    <TextBlock
                                        x:Uid="TodoCompletedLabel"
                                        FontSize="12.5"
                                        Text="已完成"/>
                                    <TextBlock
                                        FontSize="12.5"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind ViewModel.CompletedCountText, Mode=OneWay}"/>
                                </StackPanel>
                            </ToggleButton>
                            <ItemsControl
                                Margin="0,8,0,0"
                                ItemTemplateSelector="{StaticResource TaskTemplateSelector}"
                                ItemsSource="{x:Bind ViewModel.CompletedTasks, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ShowCompletedList, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <!--  ＋添加任务 quick-add bar: Enter creates and keeps focus.  -->
                <Border
                    Grid.Row="2"
                    Height="46"
                    Margin="14,0,14,12"
                    Padding="12,0"
                    Style="{StaticResource TodoCardStyle}"
                    Visibility="{x:Bind ViewModel.IsSearching, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{ThemeResource BrandAccentBrush}"
                            Glyph="&#xE710;"/>
                        <TextBox
                            x:Name="QuickAddBox"
                            x:Uid="TodoAddTaskBox"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            KeyDown="QuickAdd_KeyDown"
                            PlaceholderText="添加任务"
                            Text="{x:Bind ViewModel.QuickAddTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Resources>
                                <ResourceDictionary>
                                    <SolidColorBrush
                                        x:Key="TextControlBackground"
                                        Color="Transparent"/>
                                    <SolidColorBrush
                                        x:Key="TextControlBackgroundPointerOver"
                                        Color="Transparent"/>
                                    <SolidColorBrush
                                        x:Key="TextControlBackgroundFocused"
                                        Color="Transparent"/>
                                    <SolidColorBrush
                                        x:Key="TextControlBackgroundDisabled"
                                        Color="Transparent"/>
                                    <SolidColorBrush
                                        x:Key="TextControlBorderBrush"
                                        Color="Transparent"/>
                                    <SolidColorBrush
                                        x:Key="TextControlBorderBrushPointerOver"
                                        Color="Transparent"/>
                                    <SolidColorBrush
                                        x:Key="TextControlBorderBrushFocused"
                                        Color="Transparent"/>
                                    <SolidColorBrush
                                        x:Key="TextControlBorderBrushDisabled"
                                        Color="Transparent"/>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">
                                        0
                                    </Thickness>
                                </ResourceDictionary>
                            </TextBox.Resources>
                        </TextBox>
                        <Border
                            Grid.Column="2"
                            Padding="7,2"
                            VerticalAlignment="Center"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="↵"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <!--  ============ Right pane (360px, on demand — hidden until a task is              clicked; real-To-Do model: everything autosaves, ✕/Esc = flush & close,              footer = 删除任务 + 创建于; drag-resizable via the splitter) ============  -->
        <Border
            x:Name="DetailPane"
            Grid.Column="4"
            HorizontalAlignment="Stretch"
            Style="{StaticResource PanelCardStyle}"
            Shadow="{StaticResource PanelShadow}"
            Translation="0,0,28"
            Visibility="{x:Bind ViewModel.HasSelectedTask, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!--  ✕ strip (close = flush pending edits + collapse the pane)  -->
                <Button
                    x:Uid="TodoDetailCloseButton"
                    Grid.Row="0"
                    Width="32"
                    Height="32"
                    Margin="0,6,6,0"
                    HorizontalAlignment="Right"
                    Command="{x:Bind ViewModel.SaveDetailCommand}"
                    Style="{StaticResource TodoIconButtonStyle}">
                    <FontIcon
                        FontSize="12"
                        Glyph="&#xE711;"/>
                </Button>
                <!--  Right padding lives on the CONTENT, not the ScrollViewer:                      the overlay scrollbar rides the scroller's own padding zone,                      so a padded ScrollViewer collapses the cards' right margin                      to zero whenever the bar shows (xaml-guidelines gutter                      pattern).  -->
                <ScrollViewer
                    Grid.Row="1"
                    Padding="16,4,0,12">
                    <StackPanel
                        Margin="0,0,16,0"
                        Spacing="10">
                        <!--  Title card: check + title + star  -->
                        <Border
                            Style="{StaticResource TodoCardStyle}"
                            Padding="14,12">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
