<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Identity.Client.Broker" Version="4.91.1" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.91.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Authentication stays WinUI-free, so persistence can be exercised with
         fresh MSAL clients without a real account or an interactive sign-in. -->
    <Compile Include="..\..\src\QNote\Services\MsalCachePersistence.cs" Link="Presentation\MsalCachePersistence.cs" />
    <Compile Include="..\..\src\QNote\Services\MsalTokenProvider.cs" Link="Presentation\MsalTokenProvider.cs" />
    <Compile Include="..\..\src\QNote\Services\SyncConfigurationStore.cs" Link="Presentation\SyncConfigurationStore.cs" />
    <Compile Include="..\..\src\QNote\Services\SyncService.cs" Link="Presentation\SyncService.cs" />
    <Compile Include="..\..\src\QNote\Services\SyncService.Encryption.cs" Link="Presentation\SyncService.Encryption.cs" />
    <Compile Include="..\..\src\QNote\Services\SyncEncryptionKeyStore.cs" Link="Presentation\SyncEncryptionKeyStore.cs" />
    <Compile Include="..\..\src\QNote\ViewModels\SettingsViewModel.cs" Link="Presentation\SettingsViewModel.cs" />
    <Compile Include="..\..\src\QNote\ViewModels\SettingsViewModel.Encryption.cs" Link="Presentation\SettingsViewModel.Encryption.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests reference Core only (no WinAppSDK) so the headless test host stays clean. -->
    <ProjectReference Include="..\..\src\QNote.Core\QNote.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TodoPageViewModel family is compiled into BOTH the app and this test
         assembly (link-include): the VMs are WinUI-free by design, so this
         gives them headless coverage without referencing the WinUI app project.
         Keep this list in lockstep with the ViewModels the todo tests touch. -->
    <Compile Include="..\..\src\QNote\ViewModels\TodoPageViewModel.cs" Link="Presentation\TodoPageViewModel.cs" />
    <Compile Include="..\..\src\QNote\ViewModels\TodoNavItemViewModel.cs" Link="Presentation\TodoNavItemViewModel.cs" />
    <Compile Include="..\..\src\QNote\ViewModels\TodoTaskItemViewModel.cs" Link="Presentation\TodoTaskItemViewModel.cs" />
    <Compile Include="..\..\src\QNote\ViewModels\TodoStepItemViewModel.cs" Link="Presentation\TodoStepItemViewModel.cs" />
    <Compile Include="..\..\src\QNote\ViewModels\TodoTaskSorter.cs" Link="Presentation\TodoTaskSorter.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Notes VM behavior is tested headlessly with resource-only test stubs. -->
    <Compile Include="..\..\src\QNote\ViewModels\NotesPageViewModel.cs" Link="Presentation\NotesPageViewModel.cs" />
    <Compile Include="..\..\src\QNote\ViewModels\NoteItemViewModel.cs" Link="Presentation\NoteItemViewModel.cs" />
    <Compile Include="..\..\src\QNote\ViewModels\CategoryItemViewModel.cs" Link="Presentation\CategoryItemViewModel.cs" />
    <Compile Include="..\..\src\QNote\Services\CategoryDisplayNames.cs" Link="Presentation\CategoryDisplayNames.cs" />
    <Compile Include="..\..\src\QNote\Services\CategoryErrorText.cs" Link="Presentation\CategoryErrorText.cs" />
    <Compile Include="..\..\src\QNote\Controls\IconCatalog.cs" Link="Presentation\IconCatalog.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- QNoteIconGlyphs is link-compiled into this test assembly: it is WinUI-free
         by design, and QNoteIconsFontTests asserts its constants stay in sync with
         the shipped QNoteIcons.ttf and codepoints.json. -->
    <Compile Include="..\..\src\QNote\Controls\QNoteIconGlyphs.cs" Link="Presentation\QNoteIconGlyphs.cs" />
  </ItemGroup>

</Project>
